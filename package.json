{
  "name": "iwac-theme",
  "version": "2.23.0",
  "description": "Islam West Africa Collection Theme - A customized Omeka S theme for the IWAC digital collection.",
  "main": "gulpfile.js",
  "scripts": {
    "start": "gulp",
    "build": "npm run check:tokens && npm run build:tokens && npm run build:i18n && npm run build:js && gulp css",
    "test": "node scripts/run-tests.js",
    "test:minified": "node scripts/run-tests.js --minified",
    "test:php": "php test/php/run.php",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"asset/sass/**/*.scss\"",
    "test:live": "playwright test",
    "bump": "node scripts/bump-version.js",
    "check:js": "node scripts/check-js-syntax.js",
    "check:js-dist": "node scripts/build-js.js --check",
    "check:versions": "node scripts/check-versions.js",
    "check:audit": "node scripts/check-audit.js",
    "check:i18n": "node scripts/build-i18n.js --check",
    "check:tokens": "node scripts/check-token-usage.js",
    "build:tokens": "node scripts/build-tokens.js",
    "sync:tokens": "node scripts/build-tokens.js --sync-siblings",
    "build:i18n": "node scripts/build-i18n.js",
    "build:js": "node scripts/build-js.js",
    "build:images": "node scripts/gen-banner-images.js",
    "build:icons": "node scripts/gen-pwa-icons.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fmadore/IWAC-theme.git"
  },
  "keywords": [
    "omeka-s",
    "theme"
  ],
  "author": "Frédérick Madore",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "bugs": {
    "url": "https://github.com/fmadore/IWAC-theme/issues"
  },
  "homepage": "https://github.com/fmadore/IWAC-theme#readme",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "autoprefixer": "^10.6.1",
    "cssnano": "^9.2.0",
    "esbuild": "0.28.2",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "gulp": "^5.0.1",
    "gulp-postcss": "^10.0.0",
    "gulp-sass": "^6.0.1",
    "jsdom": "^30.1.2",
    "postcss-scss": "^4.0.9",
    "sass": "^1.105.1",
    "sharp": "^0.35.5",
    "stylelint": "^17.16.0",
    "stylelint-scss": "^7.3.0"
  },
  "browserslist": [
    "last 2 versions",
    "> 1%",
    "not dead",
    "safari >= 16.2",
    "ios >= 16.2"
  ]
}
