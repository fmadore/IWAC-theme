{
  "name": "iwac-theme",
  "version": "2.31.1",
  "description": "Islam West Africa Collection Theme - A customized Omeka S theme for the IWAC digital collection.",
  "scripts": {
    "start": "node scripts/build-css.js --watch",
    "build": "npm run check:tokens && npm run build:tokens && npm run build:i18n && npm run build:js && npm run build:css && npm run check:css",
    "build:css": "node scripts/build-css.js",
    "test": "node scripts/run-tests.js",
    "test:minified": "node scripts/run-tests.js --minified",
    "test:php": "php test/php/run.php",
    "test:browser": "playwright test --config=playwright.local.config.js",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"asset/sass/**/*.scss\"",
    "test:live": "playwright test",
    "test:live:lighthouse": "node scripts/check-lighthouse-live.js",
    "bump": "node scripts/bump-version.js",
    "check:js": "node scripts/check-js-syntax.js",
    "check:js-dist": "node scripts/build-js.js --check",
    "check:versions": "node scripts/check-versions.js",
    "check:audit": "node scripts/check-audit.js",
    "check:i18n": "node scripts/build-i18n.js --check",
    "check:tokens": "node scripts/check-token-usage.js",
    "check:fixtures": "php test/php/render-fixtures.php --check",
    "check:php": "node scripts/check-php.js",
    "check:generated": "node scripts/check-generated.js",
    "check:css": "node scripts/check-compiled-css.js",
    "build:tokens": "node scripts/build-tokens.js",
    "sync:tokens": "node scripts/build-tokens.js --sync-siblings",
    "build:i18n": "node scripts/build-i18n.js",
    "build:js": "node scripts/build-js.js",
    "build:fixtures": "php test/php/render-fixtures.php",
    "build:images": "node scripts/gen-banner-images.js",
    "build:icons": "node scripts/gen-pwa-icons.js",
    "verify": "npm run check:js && npm run lint && npm run check:versions && npm test && npm run test:minified && npm run check:js-dist && npm run build && npm run check:generated && npm run check:php && npm run check:audit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fmadore/IWAC-theme.git"
  },
  "keywords": [
    "omeka-s",
    "theme"
  ],
  "author": "Frédérick Madore",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "bugs": {
    "url": "https://github.com/fmadore/IWAC-theme/issues"
  },
  "homepage": "https://github.com/fmadore/IWAC-theme#readme",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "autoprefixer": "^10.6.1",
    "cssnano": "^9.9.0",
    "esbuild": "0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "lighthouse": "13.5.0",
    "postcss": "^8.5.32",
    "postcss-scss": "^4.0.9",
    "sass": "^1.106.1",
    "sharp": "^0.35.5",
    "stylelint": "^17.16.0",
    "stylelint-scss": "^7.4.0"
  },
  "browserslist": [
    "last 2 versions",
    "> 1%",
    "not dead",
    "safari >= 16.2",
    "ios >= 16.2"
  ]
}
