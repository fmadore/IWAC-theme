<?php
// XHR fast path for linked-resources pagination: the client sends
// X-Requested-With: fetch and only reads the linked-resources root out of
// the response. Skip the entire layout (header, banner, footer, assetUrl
// work) and output just the inner content. Vary tells shared caches never
// to serve this chrome-less fragment to a normal navigation (or vice versa).
if (($_SERVER['HTTP_X_REQUESTED_WITH'] ?? '') === 'fetch') {
    header('Vary: X-Requested-With');
    echo $this->content;
    return;
}

$siteTitle = $site->title();
$userBar = $this->userBar();
$bannerHeightMobile = $this->themeSetting('banner_height_mobile');
$bannerEyebrow = $this->themeSetting('banner_eyebrow');
$bannerHeading = $this->themeSetting('banner_heading');
$bannerDescription = $this->themeSetting('banner_description');
$bannerHeightProperty = ($bannerEyebrow || $bannerHeading || $bannerDescription) ? 'min-height' : 'height';

// Brand color: SCSS derives every primary variant (--primary,
// --primary-hover, --primary-active, --focus-ring, glows, etc.) from
// --primary-base via color-mix(in oklab, ...). PHP only needs to inject
// the raw hex if the admin overrode the default. This replaces the
// previous HSL-conversion path which produced inconsistencies between
// the SCSS-tuned palette and the runtime values.
$primaryColor = $this->themeSetting('primary_color') ?? '#e64a19';
// Secondary seed: the shared 2nd categorical / data-series colour consumed by
// the IwacVisualizations module (chart series 2, compare-corpus B). SCSS
// derives --secondary (and its dark-mode lightening) from this base.
$secondaryColor = $this->themeSetting('secondary_color') ?? '#394f68';
if (!is_string($primaryColor) || !preg_match('/^#[0-9a-f]{6}$/i', $primaryColor)) {
    $primaryColor = '#e64a19';
}
if (!is_string($secondaryColor) || !preg_match('/^#[0-9a-f]{6}$/i', $secondaryColor)) {
    $secondaryColor = '#394f68';
}

// PWA: build the per-site web-app manifest. Default ON; only an explicit
// unchecked setting ('0') disables it. The manifest is emitted as a JSON island
// in <head> and turned into a same-origin blob: manifest by js/pwa-install.js
// (themes can't register an Omeka route to serve a real per-site manifest file,
// and a data: manifest is rejected because its origin is opaque).
$pwaEnabled = ((string) $this->themeSetting('pwa_enabled')) !== '0';
$pwaManifest = $pwaEnabled ? $this->PwaManifest($site) : null;

// The hero banner only renders on the homepage (see below), so the LCP
// preload must be gated the same way — otherwise every inner page fetches
// a large unused image at high priority.
$layoutHomepage = method_exists($site, 'homepage') ? $site->homepage() : null;
$layoutIsHomepage = $layoutHomepage && $this->params()->fromRoute('page-slug') === $layoutHomepage->slug();

// For LCP: preload default banner image when no custom banner is set.
// banner-1400.webp, not banner.webp: the master is the colour source of truth
// (and gen-pwa-icons.js's input) and is never served — every served derivative
// is grayscale, because _banner.scss paints the plate through
// `filter: grayscale(1)`. See scripts/gen-banner-images.js.
$customBannerAsset = $this->themeSettingAsset('banner');
$defaultBannerUrl = $this->assetUrl('img/banner-1400.webp');
// Responsive variants (regenerate with `npm run build:images`) so phones fetch a
// right-sized hero instead of the full 1400w plate. Width-descriptor srcset;
// the <img> and the preload below both declare sizes=100vw (full-bleed banner).
$defaultBannerSrcset = $this->assetUrl('img/banner-480.webp') . ' 480w, '
    . $this->assetUrl('img/banner-768.webp') . ' 768w, '
    . $this->assetUrl('img/banner-1024.webp') . ' 1024w, '
    . $this->assetUrl('img/banner-1280.webp') . ' 1280w, '
    . $defaultBannerUrl . ' 1400w';
// Inner pages render the same plate as a slim full-bleed strip
// (.banner--compact, 72-112px tall). It has its own pre-cropped band assets --
// reusing the hero's 768w derivative meant shipping 57 KiB for a box that paints
// 375x72 CSS px. Regenerate with `npm run build:images`.
$compactStripUrl = $this->assetUrl('img/banner-strip-768.webp');
$compactStripSrcset = $compactStripUrl . ' 768w, '
    . $this->assetUrl('img/banner-strip-1400.webp') . ' 1400w';

$this->htmlElement('html')->setAttribute('lang', $this->lang());
$this->headMeta()->setCharset('utf-8');
$this->headMeta()->appendName('viewport', 'width=device-width, initial-scale=1');
$this->headTitle($siteTitle)->setSeparator(' · ');
$this->headTitle()->append($this->setting('installation_title', 'Omeka S'));
$this->headLink()->prependStylesheet($this->assetUrl('css/style.css'));
// Omeka's Font Awesome (iconfonts.css) is loaded async (see <head> below) rather
// than render-blocking: the theme's own UI now draws from Bootstrap-Icon SVG
// masks, so the icon font is only needed by a few non-critical module glyphs.
$iconfontsUrl = $this->assetUrl('css/iconfonts.css', 'Omeka');
// Single combined Google Fonts request: Public Sans (body/UI) +
// Source Serif 4 with optical-size axis (display + body). Subsetted to
// the weights actually used across the theme.
// Bunny Fonts — privacy-first, GDPR-compliant drop-in mirror of Google
// Fonts. Relevant since IWAC is hosted at ZMO Berlin (German research
// institute), where Google Fonts has been ruled non-compliant under
// GDPR in some EU jurisdictions due to IP logging. Bunny does not log.
// IMPORTANT: Bunny's /css endpoint only honors the FIRST family in a
// CSS2-style multi-"&family=" request and silently drops the rest (verified
// live: "&family=" returned Public Sans only, 0 Source Serif faces). Use the
// v1 PIPE "|" separator BETWEEN families — that returns all faces including
// the source-serif-4 opsz axis. Do NOT revert to "&family=" or the display
// serif disappears and every heading falls back to Georgia.
// Besley (Clarendon) carries the masthead + headlines; three static faces
// keep the request small. Source Serif 4 stays for long-form reading.
$this->headLink()->prependStylesheet('https://fonts.bunny.net/css?family=besley:500,600,800|public-sans:ital,wght@0,400..700;1,400|source-serif-4:ital,opsz,wght@0,8..60,400..600;1,8..60,400&display=swap');
// jQuery + Omeka's global.js are DEFERRED, with a namespace bridge around them.
//
// They loaded render-blocking until 2.19, because deferring them (tried in
// v2.6.14) threw "Omeka is not defined": core emits an *inline* jsTranslate
// block that assigns `Omeka.jsTranslate = …` while the parser is still running,
// so the `Omeka` global has to exist by then. That much was correct. What was
// never checked is how wide the problem actually is — and measured across all
// twelve live page types (homepage, item, browse, item-set, index, the two
// dashboard pages, both languages), that inline jsTranslate assignment is the
// ONLY parse-time reference to `Omeka` or `$` anywhere on the public site. No
// inline script calls `$(…)` at all.
//
// So it is one problem, and the theme owns it: the theme is what calls
// jsTranslate(). The bridge below is three tiny inline blocks:
//
//   1. before  — create the namespace so the inline assignment cannot throw;
//   2. after   — keep a reference to whatever got attached to it;
//   3. module  — re-attach those members once global.js has run.
//
// Step 3 is needed because global.js opens with `var Omeka = {…}`, a top-level
// assignment that REPLACES the object rather than extending it, so anything the
// parse-time blocks hung on it would otherwise be silently dropped. It merges
// members instead of naming jsTranslate, so an inline block from some future
// module survives the same way without another edit here.
//
// Blocks 2 and 3 are emitted as literal markup after `echo $this->headScript()`
// (see <head> below) rather than through appendScript: that puts block 2 after
// EVERY inline block any module contributed, so it captures their additions too,
// and it pins block 3's `type="module"` instead of trusting the helper to render
// an unusual type. The re-attach is an inline module rather than a file because
// inline modules are deferred and execute in document order among the deferred
// classic scripts — so it lands after global.js without costing a request.
//
// Ordering is safe on the other side too. global.js has exactly two top-level
// statements, `var Omeka = {…}` and `$(document).ready(…)`; defer preserves
// document order so jQuery is always there first, and ready callbacks fire on
// DOMContentLoaded, which is after every deferred script has run.
//
// Worth ~400ms of FCP on mobile: jquery.min.js alone is 31 KB of the ~68 KB of
// render-blocking bytes, and it was finishing at 1075ms on a throttled Moto G4,
// holding the theme's own stylesheet behind it.
$deferAttr = ['defer' => 'defer'];
$this->headScript()->prependFile($this->assetUrl('js/global.js', 'Omeka'), 'text/javascript', $deferAttr);
$this->headScript()->prependFile($this->assetUrl('vendor/jquery/jquery.min.js', 'Omeka'), 'text/javascript', $deferAttr);
// (1) Namespace must exist before core's inline jsTranslate block runs.
$this->headScript()->appendScript('window.Omeka=window.Omeka||{};');
$this->jsTranslate();
$this->trigger('view.layout');

// The theme fully owns the language switcher: a custom template (inline SVG +
// text codes, no country flags) styled entirely from this theme's style.css.
// So the Internationalisation module's render-blocking flag-icon sprite AND its
// language-switcher.css (which styles the module's default markup we replaced)
// are dead weight on every page. Drop both from the <head>.
try {
    $headLinkContainer = $this->headLink()->getContainer();
    $deadCssKeys = [];
    foreach ($headLinkContainer as $key => $item) {
        if (!isset($item->href)) {
            continue;
        }
        $href = (string) $item->href;
        if (strpos($href, 'flag-icon') !== false
            || strpos($href, 'Internationalisation/asset/css/language-switcher') !== false
        ) {
            $deadCssKeys[] = $key;
        }
    }
    foreach ($deadCssKeys as $key) {
        unset($headLinkContainer[$key]);
    }
} catch (\Throwable $e) {
    // Non-fatal: if the placeholder shape changes upstream, keep the stylesheets.
}

// citation.js is the "How to cite" panel's progressive enhancement — a style
// switcher and a copy button over markup that already renders and already works
// without it (the downloads are real links). It is enqueued by IWAC-SEO as a
// plain <script src> in the <head>, so it blocked first paint on every resource
// page to wire a control below the fold. It is vanilla (IWACUtils.onReady, no
// jQuery), so deferring it changes nothing but when it runs.
//
// Done here rather than at the enqueue site because the module owns that; this
// is the same "the theme knows what its own <head> needs" pass as the dead-CSS
// filter above.
try {
    foreach ($this->headScript()->getContainer() as $scriptItem) {
        if (empty($scriptItem->attributes['src'])) {
            continue;
        }
        if (strpos((string) $scriptItem->attributes['src'], 'js/citation.js') !== false) {
            $scriptItem->attributes['defer'] = 'defer';
        }
    }
} catch (\Throwable $e) {
    // Non-fatal: a blocking citation.js is slower, not broken.
}

if ($userBar) {
	$this->htmlElement('body')->appendAttribute('class', 'user-bar');
}
?>

<?php echo $this->doctype(); ?>
<?php echo $this->htmlElement('html'); ?>
	<head>
		<?php
		// Charset + viewport MUST come first. The banner preload below selects a
		// srcset candidate via imagesizes="100vw"; the preload scanner evaluates
		// that against the 980px *default* viewport unless <meta viewport> has
		// already been parsed — which would force the largest (1400w) image and
		// waste the high-priority fetch. Emitting headMeta first fixes the pick.
		echo $this->headMeta();
		?>
		<link rel="preconnect" href="https://fonts.bunny.net" crossorigin>
		<?php if (!$customBannerAsset && $layoutIsHomepage): ?>
		<link rel="preload" as="image" fetchpriority="high"
		      href="<?php echo $this->escapeHtmlAttr($defaultBannerUrl); ?>"
		      imagesrcset="<?php echo $this->escapeHtmlAttr($defaultBannerSrcset); ?>"
		      imagesizes="100vw">
		<?php elseif ($customBannerAsset && $layoutIsHomepage): ?>
		<?php // Admin-uploaded banners are still the homepage LCP — preload the
		      // same large derivative common/banner.phtml renders. ?>
		<link rel="preload" as="image" fetchpriority="high"
		      href="<?php echo $this->escapeHtmlAttr($customBannerAsset->assetUrl()); ?>">
		<?php endif; ?>
		<?php // NOTE: the inner-page compact strip is deliberately NOT preloaded,
		      // though it is an LCP candidate (see common/banner.phtml). A preload
		      // here is emitted before the stylesheet link, so it competes with the
		      // render-blocking CSS on every inner page — measurably delaying FCP,
		      // and with it the text LCP of any page whose title is the largest
		      // paint. The strip is a plain <img src> near the top of <body>, so
		      // the preload scanner already starts it at ~350ms; it only ever
		      // needed to stop being fetchpriority=low. With the small band assets
		      // it now completes around 600ms unaided. ?>
		<?php echo $this->headTitle(); ?>
		<?php echo $this->headLink(); ?>
		<?php echo $this->headStyle(); ?>
		<?php echo $this->headScript(); ?>
		<?php // (2) and (3) of the Omeka namespace bridge — see the note beside the
		      // headScript() calls above. (2) runs at parse time, after every inline
		      // block in the <head>; (3) is a module, so it runs after the deferred
		      // jQuery and global.js, whose `var Omeka = {…}` replaced the object. ?>
		<script>window.__iwacOmekaEarly=window.Omeka;</script>
		<script type="module">var e=window.__iwacOmekaEarly,o=window.Omeka;if(e&&o&&e!==o){for(var k in e){if(!(k in o)){o[k]=e[k];}}}</script>

		<?php // Font Awesome (Omeka iconfonts.css) loaded async so the icon font never blocks first paint. ?>
		<link rel="preload" as="style" href="<?php echo $this->escapeHtmlAttr($iconfontsUrl); ?>" onload="this.onload=null;this.rel='stylesheet'">
		<noscript><link rel="stylesheet" href="<?php echo $this->escapeHtmlAttr($iconfontsUrl); ?>"></noscript>

		<style type="text/css" media="screen">
			:root {
				/* Brand seeds; SCSS derives every primary/secondary variant via color-mix(in oklab, ...) */
				--primary-base: <?php echo $this->escapeHtml($primaryColor); ?>;
				--secondary-base: <?php echo $this->escapeHtml($secondaryColor); ?>;
			}
		</style>
		
		<?php if ($bannerHeightMobile && preg_match('/^-?[0-9]*\.?[0-9]+(px|em|rem|%|vh|vw|svh|dvh|lvh)$/', trim($bannerHeightMobile))): ?>
		<?php // 767px, not 768px: max-width sits at breakpoint − 1 so it never
		      // overlaps the `min-width: $md` half. See abstracts/variables/_breakpoints.scss. ?>
		<style type="text/css" media="screen and (max-width:767px)">
			.banner:not(.banner--compact) {
				<?php echo $this->escapeHtml($bannerHeightProperty) . ': ' . $this->escapeHtml(trim($bannerHeightMobile)) . ' !important;'; ?>
			}
		</style>
		<?php endif; ?>

		<?php if ($pwaEnabled): ?>
		<?php // PWA: icons, status-bar theming, and the manifest data island.
		      // js/pwa-install.js (loaded at body end) turns the island into a
		      // same-origin blob: manifest and wires the masthead install button.
		      //
		      // The two theme-color values are --surface, one per scheme. A
		      // <meta> can't read a custom property, so these are copies — but
		      // they are ASSERTED copies: scripts/check-token-usage.js (the
		      // `npm run check:tokens` gate) parses them out of this file and
		      // fails on any disagreement with tokens.json. Change --surface and
		      // the gate tells you to change these too. ?>
		<meta name="theme-color" media="(prefers-color-scheme: light)" content="#fdfcfb">
		<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#110c08">
		<meta name="mobile-web-app-capable" content="yes">
		<meta name="apple-mobile-web-app-capable" content="yes">
		<meta name="apple-mobile-web-app-status-bar-style" content="default">
		<meta name="apple-mobile-web-app-title" content="<?php echo $this->escapeHtmlAttr($pwaManifest['short_name']); ?>">
		<?php // The scalable favicon, listed FIRST so engines that support SVG
		      // icons take it; Safari and older engines ignore an image/svg+xml
		      // icon and fall through to the PNGs below, which look the same.
		      // The whole set stays light in both colour schemes — see
		      // faviconSvg() in scripts/gen-pwa-icons.js for why. ?>
		<link rel="icon" type="image/svg+xml" sizes="any" href="<?php echo $this->escapeHtmlAttr($this->assetUrl('img/pwa/favicon.svg')); ?>">
		<link rel="icon" type="image/png" sizes="32x32" href="<?php echo $this->escapeHtmlAttr($this->assetUrl('img/pwa/favicon-32.png')); ?>">
		<link rel="icon" type="image/png" sizes="16x16" href="<?php echo $this->escapeHtmlAttr($this->assetUrl('img/pwa/favicon-16.png')); ?>">
		<link rel="apple-touch-icon" sizes="180x180" href="<?php echo $this->escapeHtmlAttr($this->assetUrl('img/pwa/apple-touch-icon.png')); ?>">
		<script type="application/json" id="iwac-pwa-manifest"><?php echo json_encode($pwaManifest, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_HEX_TAG); ?></script>
		<?php endif; ?>
	</head>

	<?php echo $this->htmlElement('body'); ?>
		<script>
		// Apply theme synchronously before first paint to prevent FOUC.
		// Mirrors getMode()/resolveTheme() in js/theme-toggle.js.
		(function () {
			try {
				var stored = localStorage.getItem('iwac-theme-preference');
				var theme = (stored === 'light' || stored === 'dark')
					? stored
					: (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
				document.body.setAttribute('data-theme', theme);
				document.body.setAttribute('data-theme-mode', (stored === 'light' || stored === 'dark') ? stored : 'system');
			} catch (e) {}
		})();
		</script>
		<a id="skipnav" href="#content"><?php echo $this->translate('Skip to main content'); ?></a>

		<?php echo $this->partial('common/header', ['userBar' => $userBar, 'site' => $site]); ?>

		<?php
		// The full hero renders on the site homepage only; inner pages carry
		// a slim compact band of the same duotone plate so the page doesn't
		// open on bare whitespace between the section strip and the title.
		// Only the homepage hero is LCP-preloaded (see <head>); the compact
		// band asks for the image at low priority.
		echo $this->partial('common/banner', [
			'compact' => !$layoutIsHomepage,
			'srcset' => $defaultBannerSrcset,
			'stripSrc' => $compactStripUrl,
			'stripSrcset' => $compactStripSrcset,
		]);
		?>

		<main id="content" class="container" tabindex="-1">
			<?php echo $this->content; ?>
		</main>

		<?php echo $this->partial('common/footer'); ?>

		<button type="button" id="back-to-top" class="back-to-top" aria-label="<?php echo $this->escapeHtmlAttr($this->translate('Back to top')); ?>"></button>

		<?php
		if ($pwaEnabled) {
			// Loaded at body end like the theme's other vanilla scripts (order:
			// utils.js first — see the prepend chain below). Self-guards if the
			// manifest island or install button is absent.
			$this->inlineScript()->prependFile($this->assetUrl('js/pwa-install.js'));
		}
		echo $this->inlineScript()
			->prependFile($this->assetUrl('js/plate-viewer.js'))
			->prependFile($this->assetUrl('js/mirador-theme-sync.js'))
			->prependFile($this->assetUrl('js/pagination-scroll.js'))
			->prependFile($this->assetUrl('js/theme-toggle.js'))
			->prependFile($this->assetUrl('js/navigation.js'))
			->prependFile($this->assetUrl('js/script.js'))
			->prependFile($this->assetUrl('js/utils.js'));
		?>
	</body>
</html>
