<?php
// Core's omeka/site/page/show.phtml (Omeka S 4.2.1), with two changes:
//
// 1. The breadcrumb is the theme's crumb line (common/page-breadcrumbs) —
//    the same markup as a resource page's, named as a landmark — instead of
//    Laminas' `a > span` chain.
// 2. It is printed here only when the page does NOT open on the plate page
//    head. When it does (its first block is a page title; see
//    helper/PageHead.php), the page-title block prints the crumb inside the
//    plate, above the title, so it never strands between the masthead and
//    the band.
//
// Everything else is core's (displayNavigation is read as the extracted view
// variable rather than `$this->displayNavigation`, the same value under
// Laminas, so the fixture renderer can supply it): keep it that way, and
// re-diff against core when Omeka S is upgraded.
$this->headLink()->appendStylesheet($this->assetUrl('css/page-blocks.css', 'Omeka'));
$this->htmlElement('body')->appendAttribute('class', $pageBodyClass);
$this->pageTitle($page->title(), 2);
$nav = $site->publicNav();
$activePage = $nav->findActive($nav->getContainer());
$displayNavigation = !empty($displayNavigation);
switch ($this->siteSetting('subnav_display')) {
    case 'show':
        $displaySubnav = $displayNavigation;
        break;
    case 'hide':
        $displaySubnav = false;
        break;
    default:
        $displaySubnav = $displayNavigation && $activePage && $activePage['page']->hasPages();
}
$showPagePagination = $this->siteSetting('show_page_pagination', true);
$pageHead = $this->PageHead();
$crumbs = ($activePage && !$pageHead->opensWithPlate($page)) ? $pageHead->crumbs() : [];
?>

<?php if ($crumbs): ?>
<?php echo $this->partial('common/page-breadcrumbs', ['crumbs' => $crumbs]); ?>
<?php endif; ?>

<?php if ($activePage): ?>
<?php if ($displaySubnav): ?>
<nav class="sub-menu"><?php echo $nav->menu()->renderSubMenu(); ?></nav>
<?php endif; ?>
<?php endif; ?>

<?php $this->trigger('view.show.before'); ?>
<div class="blocks">
    <?php echo $this->content; ?>
</div>
<?php $this->trigger('view.show.after'); ?>
<?php if ($showPagePagination): ?>
<?php echo $this->sitePagePagination(); ?>
<?php endif; ?>
