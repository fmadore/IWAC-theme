<?php
// Plain item browse is the shared listing — the same one item sets and media
// browse through. This template only owns the case core routes here too: an
// item set's own page, which renders its items as a ledger table.
if (!isset($itemSet)) {
    echo $this->partial('common/resource-browse', [
        'resources' => $items,
        'resourceName' => 'items',
        'bodyClass' => 'item resource browse',
        'liClass' => 'item',
        'title' => $this->translate('Items'),
    ]);
    return;
}

$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');
$escapeAttr = $this->plugin('escapeHtmlAttr');
$this->headLink()->appendStylesheet($this->assetUrl('css/resource-page-blocks.css', 'Omeka'));
$this->htmlElement('body')->appendAttribute('class', 'item resource browse item-set');

$filterLocale = (bool) $this->siteSetting('filter_locale_values');
$lang = $this->lang();
$valueLang = $filterLocale ? [$lang, ''] : null;

$query = $this->params()->fromQuery();
$query['item_set_id'] = $itemSet->id();
$collectionSearchUrl = $this->getHelperPluginManager()->has('iwacSearchUrl')
    ? $this->iwacSearchUrl()
    : $this->url('site/resource', ['controller' => 'item', 'action' => 'search'], ['query' => $query], true);

// The set's items through IwacSearch's Typesense surface — full-text search,
// facets, sort and paging over the whole set — when the module is active and
// its index covers this set. The helper returns '' otherwise (Typesense down,
// an authority set the content index does not hold, a signed-in editor whose
// count includes private items, any failure), and the page keeps the ledger
// below: core's browse, which the controller has already run.
$setSearch = $this->getHelperPluginManager()->has('iwacItemSetSearch')
    ? (string) $this->iwacItemSetSearch($itemSet)
    : '';
?>

<?php echo $this->ResourceTags($itemSet); ?>
<?php echo $this->pageTitle($this->FrenchSpacing($itemSet->displayTitle(null, $valueLang)), 1); ?>

<?php echo $this->partial('common/resource-regions', ['resource' => $itemSet]); ?>

<div class="item-set-items">
    <h2><?php echo $escape($translate('Items')); ?></h2>

    <?php if ($setSearch !== ''): ?>

    <?php $this->trigger('view.browse.before'); ?>
    <?php echo $setSearch; ?>

    <?php else: ?>

    <?php
    // The ledger's search and AJAX paging. No masonry or browse.js: there is
    // no card grid and no grid/list toggle on this page.
    $this->inlineScript()->appendFile($this->assetUrl('js/dist/linked-resources.min.js'));
    ?>
    <?php echo $this->searchFilters(); ?>

    <div class="browse-controls">
        <?php echo $this->browse()->renderSortSelector('items'); ?>
        <div class="advanced-search-container">
            <?php echo $this->hyperlink($translate('Search the collection'), $collectionSearchUrl, ['class' => 'advanced-search']); ?>
        </div>
    </div>

    <?php $this->trigger('view.browse.before'); ?>

    <?php
    // Ledger table mirroring the item pages' linked-resources section —
    // same classes (the linked-resources CSS applies as-is) and the same
    // .linked-resources root, so linked-resources.js provides the search
    // and AJAX pagination here too. The id differs from the linked-resources
    // page block's so both can coexist on one page, and so does the query
    // parameter each pages through: this ledger is core's browse, on `page`;
    // the block is on `lr_page`. data-query-params names this ledger's state,
    // so linked-resources.js keeps each root's state in the address while the
    // other one swaps.
    //
    // The title search is core's own browse query — one `property` row,
    // "dcterms:title contains …" — so it searches every item in the set, not
    // the five on screen, and core's search filters above name it. The row is
    // keyed `title`, not 0, so it can never overwrite a property filter the
    // reader arrived with.
    $titleRow = 'property[title]';
    $titleFields = [
        $titleRow . '[joiner]' => 'and',
        $titleRow . '[property]' => 'dcterms:title',
        $titleRow . '[type]' => 'in',
    ];
    $titleQuery = $this->params()->fromQuery('property');
    $titleSearch = is_array($titleQuery) && is_array($titleQuery['title'] ?? null) && is_string($titleQuery['title']['text'] ?? null)
        ? (string) $titleQuery['title']['text']
        : '';
    $noResultsText = $translate('No resources match your search.');
    $rows = [];
    foreach ($items as $item) {
        $rows[] = ['resource' => $item, 'relationLabel' => null];
    }
    ?>
    <div id="item-set-resources"
         class="linked-resources"
         data-total="<?php echo $escapeAttr($this->pagination()->getPaginator()->getTotalCount()); ?>"
         data-no-results-text="<?php echo $escapeAttr($noResultsText); ?>"
         data-results-found-text="<?php echo $escapeAttr($translate('{count} resources found')); ?>"
         data-page-results-text="<?php echo $escapeAttr($translate('{count} resources on this page')); ?>"
         data-query-params="<?php echo $escapeAttr(implode(' ', array_merge(['page', 'sort_by', 'sort_order', $titleRow . '[text]'], array_keys($titleFields)))); ?>">

        <div class="linked-resources__controls">
            <?php echo $this->partial('common/linked-resources-search', [
                'part' => 'form',
                'action' => $this->url(null, [], [], true),
                'inputId' => 'item-set-resources-search',
                'searchName' => $titleRow . '[text]',
                'searchValue' => $titleSearch,
                'label' => $translate('Search the items in this set by title'),
                'skip' => ['page', $titleRow . '[text]'],
                'hidden' => $titleFields,
            ]); ?>
        </div>

        <?php echo $this->partial('common/linked-resources-search', ['part' => 'feedback', 'noResults' => !$rows, 'noResultsText' => $noResultsText]); ?>

        <?php echo $this->partial('common/linked-resources-table', [
            'rows' => $rows,
            'showRelation' => false,
            'valueLang' => $valueLang,
        ]); ?>

        <div class="linked-footer">
            <?php echo $this->pagination(); ?>
        </div>

    </div>

    <?php endif; ?>
</div>

<?php $this->trigger('view.browse.after'); ?>
