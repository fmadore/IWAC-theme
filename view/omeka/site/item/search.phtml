<?php
$translate = $this->plugin('translate');
$this->htmlElement('body')->appendAttribute('class', 'items search');

// IwacSearch is the collection's canonical search surface. Keep this theme
// override as a compatibility bridge for bookmarks and core-generated links
// until the module owns the legacy Omeka routes itself (IwacSearch #36).
if ($this->getHelperPluginManager()->has('iwacSearchUrl')) {
    $target = $this->iwacSearchUrl();
    $query = $this->params()->fromQuery('q')
        ?? $this->params()->fromQuery('fulltext_search');
    if (is_scalar($query) && '' !== trim((string) $query)) {
        $target .= (str_contains($target, '?') ? '&' : '?')
            . http_build_query(['q' => trim((string) $query)]);
    }

    $this->headTitle($translate('Search'));
    $this->headMeta()->appendHttpEquiv('refresh', '0;url=' . $target);
    $this->inlineScript()->appendScript(sprintf(
        'window.location.replace(%s);',
        json_encode($target, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT)
    ));
    ?>
    <main class="search-redirect" aria-labelledby="search-redirect-heading">
        <h1 id="search-redirect-heading"><?php echo $this->escapeHtml($translate('Opening search…')); ?></h1>
        <p>
            <?php echo $this->escapeHtml($translate('You are being redirected to the collection search.')); ?>
            <a href="<?php echo $this->escapeHtmlAttr($target); ?>">
                <?php echo $this->escapeHtml($translate('Continue to search')); ?>
            </a>
        </p>
    </main>
    <?php
    return;
}
?>

<h2><?php echo $translate('Advanced item search'); ?></h2>
<form id="advanced-search" method="get" action="<?php echo $this->escapeHtmlAttr($this->url(null, ['action' => 'browse'], true)); ?>">
<?php echo $this->partial(
    'common/advanced-search',
    ['query' => $this->params()->fromQuery(), 'resourceType' => 'item']
); ?>
<div id="page-actions">
    <input type="submit" name="submit" value="<?php echo $this->escapeHtmlAttr($translate('Search')); ?>">
    <input type="reset" value="<?php echo $this->escapeHtmlAttr($translate('Reset')); ?>" name="reset" class="reset-button btn--secondary" />
</div>
</form>
