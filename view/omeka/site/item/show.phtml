<?php
// XHR fast path: linked-resources pagination fetches /item/<id>?page=N with
// X-Requested-With: fetch and discards everything except the linked-resources
// block. Render only that block's partial so we don't pay for the heavy
// Visualizations block, value rows, media list, etc. Layout chrome is
// stripped by the matching early return at the top of layout/layout.phtml,
// which also emits the Vary: X-Requested-With header for shared caches.
if (($_SERVER['HTTP_X_REQUESTED_WITH'] ?? '') === 'fetch') {
    header('Vary: X-Requested-With');
    echo $this->partial('common/resource-page-block-layout/linked-resources', ['resource' => $item]);
    return;
}

$this->headLink()->appendStylesheet($this->assetUrl('css/resource-page-blocks.css', 'Omeka'));
$this->htmlElement('body')->appendAttribute('class', 'item resource show');

$filterLocale = (bool) $this->siteSetting('filter_locale_values');
$lang = $this->lang();
$valueLang = $filterLocale ? [$lang, ''] : null;
?>

<?php // Wayfinding first, then identity: the trail says where this record sits,
      // the dateline says what it is. Above the dateline, not below it, because
      // a reader arriving from a search engine asks "where am I" before "what
      // is this". ?>
<?php echo $this->partial('common/breadcrumbs', ['resource' => $item, 'valueLang' => $valueLang]); ?>
<?php echo $this->partial('common/item-dateline', ['resource' => $item, 'valueLang' => $valueLang, 'citeJump' => true]); ?>
<?php // FrenchSpacing: the headline is the one place a French spaced colon has
      // room to strand itself at a line start (five-line wrap at 375px). See
      // helper/FrenchSpacing.php. Helper names are case-sensitive on the server
      // — this must match config/theme.ini's helpers[] spelling exactly. ?>
<?php echo $this->pageTitle($this->FrenchSpacing($item->displayTitle(null, $valueLang)), 1); ?>

<?php $this->trigger('view.show.before'); ?>

<?php echo $this->partial('common/resource-regions', ['resource' => $item]); ?>

<?php
// The "How to cite" panel is a resource page block ("How to cite", provided by
// the IWAC-SEO module) rendered through resource-regions above — placed via
// Admin → Themes → Configure resource pages, not hard-coded here. The theme
// still owns its UI (view/common/citation.phtml + components/citation +
// asset/js/citation.js); the block delegates to that partial.
?>
<?php $this->trigger('view.show.after'); ?>
