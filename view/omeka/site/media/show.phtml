<?php
$translate = $this->plugin('translate');
$item = $media->item();

$this->headLink()->appendStylesheet($this->assetUrl('css/resource-page-blocks.css', 'Omeka'));
$this->htmlElement('body')->appendAttribute('class', 'media resource show');

$filterLocale = (bool) $this->siteSetting('filter_locale_values');
$lang = $this->lang();
$valueLang = $filterLocale ? [$lang, ''] : null;
?>

<?php // Same trail as the item page, with the parent item as its own crumb: a
      // media page is one level deeper, and "Part of %s" at the foot of the
      // page is too late to answer "where am I". ?>
<?php echo $this->partial('common/breadcrumbs', [
    'resource' => $media,
    'valueLang' => $valueLang,
    'trail' => [['label' => $item->displayTitle(null, $valueLang), 'url' => $item->siteUrl()]],
]); ?>
<?php // Same identity device as the item page — dateline from the parent
      // item (the media inherits its press context), not resource-tag pills. ?>
<?php echo $this->partial('common/item-dateline', ['resource' => $item, 'valueLang' => $valueLang]); ?>
<?php echo $this->pageTitle($media->displayTitle(null, $valueLang), 1); ?>

<?php $this->trigger('view.show.before'); ?>

<?php echo $this->partial('common/resource-regions', ['resource' => $media]); ?>

<p class="media-parent-item textcenter">
    <?php echo sprintf($translate('Part of %s'), $item->link($item->displayTitle(null, $valueLang))); ?>
</p>

<?php $this->trigger('view.show.after'); ?>
