<?php
/**
 * Dateline — the press convention: TYPE · PUBLISHER · DATE in tracked
 * uppercase above the headline (replaces the colored resource-tag pills).
 * Each segment is optional; resource-backed segments link to their record.
 * The recurring identity device (see CLAUDE.md).
 *
 * Expected variables:
 * - $resource: the item (on media pages, pass the parent item)
 * - $valueLang: locale filter, or null
 * - $citeJump: optional bool — render the CITE jump to the "How to cite"
 *   panel. Rendered `hidden`; asset/js/citation.js unhides it only on pages
 *   that actually carry the panel, because whether the block is in the stack
 *   is an admin decision this template cannot see. No JS, no dangling link.
 */
$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');

$datelineParts = [];

$classLabel = $resource->displayResourceClassLabel();
if ($classLabel) {
    $datelineParts[] = $escape($translate($classLabel));
}

$publisherValue = $resource->value('dcterms:publisher');
if ($publisherValue) {
    $publisherResource = $publisherValue->valueResource();
    if ($publisherResource) {
        $datelineParts[] = '<a href="' . $this->escapeHtmlAttr($publisherResource->siteUrl()) . '">'
            . $escape($publisherResource->displayTitle(null, $valueLang)) . '</a>';
    } else {
        $publisherLiteral = (string) $publisherValue->value();
        if ($publisherLiteral !== '') {
            $datelineParts[] = $escape($publisherLiteral);
        }
    }
}

$dateValue = $resource->value('dcterms:date');
if ($dateValue && !$dateValue->valueResource()) {
    // asHtml() lets NumericDataTypes render the localized date.
    $datelineParts[] = $dateValue->asHtml();
}

$citeJump = isset($citeJump) ? (bool) $citeJump : false;
?>
<?php if ($datelineParts || $citeJump): ?>
<p class="item-dateline"><?php echo implode(' <span class="item-dateline__sep" aria-hidden="true">·</span> ', $datelineParts); ?>
    <?php if ($citeJump): ?>
    <a class="item-dateline__cite" href="#how-to-cite" data-cite-jump hidden><?php echo $escape($translate('Cite')); ?></a>
    <?php endif; ?>
</p>
<?php endif; ?>
