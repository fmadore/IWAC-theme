<?php
$escHtml = $this->plugin('escapeHtml');
$escAttr = $this->plugin('escapeHtmlAttr');
$translate = $this->plugin('translate');

$banner = $this->themeSettingAsset('banner');
$bannerWidth = $this->themeSetting('banner_width') ?? '';
$bannerHeight = $this->themeSetting('banner_height') ?? '';
$bannerVerticalPosition = ($this->themeSetting('banner_v_position')) ?? 'center';
$bannerHorizontalPosition = ($this->themeSetting('banner_h_position')) ?? 'center';
if (!in_array($bannerVerticalPosition, ['top', 'center', 'bottom'], true)) {
    $bannerVerticalPosition = 'center';
}
if (!in_array($bannerHorizontalPosition, ['left', 'center', 'right'], true)) {
    $bannerHorizontalPosition = 'center';
}

$bannerEyebrow = $this->themeSetting('banner_eyebrow');
$bannerHeading = $this->themeSetting('banner_heading');
$bannerDescription = $this->themeSetting('banner_description');
// The banner_description setting is empty on both live sites, so the hero
// proved the collection's scale without ever saying what the collection is —
// the only one-sentence statement of scope sat in the footer. Fall back to it
// here; an admin value still wins. Only the full hero renders the paragraph
// (see the !$compact guard below), but the value is set before the
// $bannerHeightProperty and .has-text decisions so both count the dek as text.
if (!$bannerDescription) {
    $bannerDescription = $translate('An open-access collection of newspapers, Islamic publications, archives, audiovisual sources, and academic references on Islam and Muslims in Benin, Burkina Faso, Côte d\'Ivoire, Niger, Nigeria, and Togo.');
}
$bannerContentPosition = $this->themeSetting('banner_content_position') ?? 'left';
if (!in_array($bannerContentPosition, ['left', 'center', 'right'], true)) {
    $bannerContentPosition = 'left';
}

// Default banner image path (included with theme). The served top-width
// derivative, not the colour master — see layout.phtml / gen-banner-images.js.
$defaultBannerUrl = $this->assetUrl('img/banner-1400.webp');
// Width-descriptor srcset for the default hero, computed in layout.phtml so the
// LCP preload and this image element stay in sync. Empty for a custom banner.
$bannerSrcset = isset($srcset) ? $srcset : '';
// Pre-cropped centre band for the inner-page strip, also computed in
// layout.phtml so the preload and this element request the same candidate.
$stripSrc = isset($stripSrc) ? $stripSrc : $this->assetUrl('img/banner-strip-768.webp');
$stripSrcset = isset($stripSrcset) ? $stripSrcset : '';
$hasCustomBanner = (bool) $banner;

$bannerHeightProperty = ($bannerEyebrow || $bannerHeading || $bannerDescription) ? 'min-height' : 'height';

// Inner (non-home) pages get a short image strip; only the homepage shows the
// full hero with the configurable height and overlay text.
$compact = !empty($compact);

$bannerInlineStyles = '';
$imageInlineStyles = '';

if (!$compact) {
    // Validate before it reaches the style attribute. This is a free-text
    // admin setting spliced straight into inline CSS; escapeHtmlAttr stops an
    // attribute breakout but not `10px; background: url(https://…)`. The
    // mobile counterpart in layout.phtml has always guarded with this same
    // pattern — match it here rather than trusting the field.
    $bannerHeight = trim((string) $bannerHeight);
    $bannerHeightValid = $bannerHeight !== ''
        && preg_match('/^-?[0-9]*\.?[0-9]+(px|em|rem|%|vh|vw|svh|dvh|lvh)$/', $bannerHeight);
    if ($bannerHeightValid) {
        $bannerInlineStyles .= "{$bannerHeightProperty}: {$bannerHeight};";
    } else {
        // Default hero stature: tall enough to carry the display heading,
        // capped so the fold still shows content underneath.
        $bannerInlineStyles .= "{$bannerHeightProperty}: clamp(20rem, 42vh, 32rem);";
    }
}

$imageInlineStyles .= "object-position: {$bannerHorizontalPosition} {$bannerVerticalPosition};";

// banner_width is a select, but only its two declared options are meaningful
// as class names — whitelist rather than concatenating the stored value.
$class = ['banner'];
if (in_array($bannerWidth, ['container', 'alignfull'], true)) {
    $class[] = $bannerWidth;
}
if ($compact) {
    $class[] = 'banner--compact';
} elseif ($bannerEyebrow || $bannerHeading || $bannerDescription) {
    $class[] = 'has-text';
}
?>

<div class="<?php echo $escAttr(implode(' ', $class)); ?>" style="<?php echo $escAttr($bannerInlineStyles); ?>">

    <?php
    // Both are LCP candidates. The hero obviously so; the compact band because
    // it paints a full-bleed 72-112px strip at the top of the viewport, which on
    // a phone outranks any item title shorter than ~2.5 lines. The band carried
    // fetchpriority=low on the reasoning that a decorative image should not
    // compete with content fetches — but the browser was painting it above the
    // fold regardless, so the only effect was to hold an LCP element in flight
    // for ~3s. Measured on a throttled Moto G4 against the live site: the strip
    // completed at 3.5-4.9s and WAS the LCP (3.5s) on short-titled items;
    // unthrottled priority plus the small band assets bring it in by ~0.6s.
    // "Decorative" is not a property the LCP algorithm can read.
    $imageFetchPriority = 'high';
    ?>
    <?php
    // The image lives in its own clipping layer so the Ken Burns zoom is
    // contained WITHOUT the banner itself having to clip overflow — that
    // overflow:hidden was swallowing the IwacSearch typeahead panel the moment
    // it grew past the banner's bottom edge (the dropdown is appended inside
    // .banner__content, which sits outside this layer). See _banner.scss.
    ?>
    <div class="banner__media">
    <?php if ($hasCustomBanner): ?>
        <?php echo $this->thumbnail($banner, 'large', ['style' => $imageInlineStyles, 'role' => 'presentation', 'aria-hidden' => 'true', 'fetchpriority' => $imageFetchPriority]); ?>
    <?php elseif ($compact): ?>
        <?php // The band has its own pre-cropped ~6.25:1 assets rather than a
              // 16:9 hero derivative: at 768x123 it carries the same texture in
              // 14 KiB instead of 57 KiB, because object-fit:cover is no longer
              // discarding most of the file. ?>
        <?php // sizes=50vw, not 100vw: the band is an aria-hidden duotone texture
              // cropped to a 72px strip, so half-density sampling is invisible —
              // and it keeps a DPR-3 phone on the 768w candidate (14 KiB) instead
              // of pulling the 1400w one (36 KiB) it would otherwise demand. ?>
        <img src="<?php echo $escAttr($stripSrc); ?>"
             <?php if ($stripSrcset): ?>srcset="<?php echo $escAttr($stripSrcset); ?>"
             sizes="50vw"
             <?php endif; ?>width="768"
             height="123"
             style="<?php echo $escAttr($imageInlineStyles); ?>"
             role="presentation"
             aria-hidden="true"
             alt=""
             fetchpriority="high">
    <?php else: ?>
        <img src="<?php echo $escAttr($defaultBannerUrl); ?>"
             <?php if ($bannerSrcset): ?>srcset="<?php echo $escAttr($bannerSrcset); ?>"
             sizes="100vw"
             <?php endif; ?>width="1400"
             height="787"
             style="<?php echo $escAttr($imageInlineStyles); ?>"
             role="presentation"
             aria-hidden="true"
             alt=""
             fetchpriority="<?php echo $escAttr($imageFetchPriority); ?>">
    <?php endif; ?>
    </div>

    <?php if (!$compact): ?>
    <?php
    // Data access and IWAC class mappings live in the helper; this template
    // only maps the resulting values to translated presentation labels.
    $bannerStats = $this->BannerStats();
    $counts = $bannerStats['counts'];

    // A painted figure that refuses to be a door is a dead end (P1). Three of
    // the four lead counts have a destination page — but the slugs differ per
    // site (the French site browses at /parcourir), so resolve them by slug
    // lookup against THIS site's pages rather than composing a path. A site
    // without the page — any non-IWAC install of the theme — keeps the plain
    // figure. Countries has no page at all and stays a figure everywhere.
    $statPageUrls = [];
    try {
        $currentSite = $this->currentSite();
        if ($currentSite) {
            $pagesBySlug = [];
            foreach ($currentSite->pages() as $sitePage) {
                $pagesBySlug[$sitePage->slug()] = $sitePage;
            }
            $statPageSlugs = [
                'items' => ['browse', 'parcourir'],
                'index' => ['index'],
                // The newspapers figure opens the collection-overview
                // dashboard: its newspaper-coverage panel lists exactly the
                // titles the figure counts.
                'newspapers' => ['collection-overview', 'vue-d-ensemble'],
            ];
            foreach ($statPageSlugs as $statKey => $slugs) {
                foreach ($slugs as $slug) {
                    if (isset($pagesBySlug[$slug])) {
                        $statPageUrls[$statKey] = $pagesBySlug[$slug]->siteUrl();
                        break;
                    }
                }
            }
        }
    } catch (\Throwable $error) {
        // The hero must render whatever the page API does. Unlinked figures
        // are the degraded state, not a broken homepage.
        $statPageUrls = [];
    }

    $summary = $bannerStats['summary'];

    $stats = null;
    if ($counts) {
        $stats = [
            ['n' => $counts['items'], 'label' => $translate('Items'), 'featured' => true, 'url' => $statPageUrls['items'] ?? null],
            ['n' => $counts['index'], 'label' => $translate('Index'), 'url' => $statPageUrls['index'] ?? null],
        ];
        // Distinct press titles across articles and Islamic publications.
        // This one rides the data snapshot rather than the live API — a
        // distinct-values aggregate the core Omeka API cannot count in one
        // query. Without a snapshot the row simply degrades to three figures.
        if (isset($summary['newspapers'])) {
            $stats[] = ['n' => $summary['newspapers'], 'label' => $translate('Newspapers'), 'url' => $statPageUrls['newspapers'] ?? null];
        }
        $stats[] = ['n' => $counts['countries'], 'label' => $translate('Countries')];
    }
    $thin = "\xE2\x80\xAF"; // U+202F narrow no-break space — locale-neutral digit grouping

    $substats = null;
    if ($summary) {
        $depthFields = [
            'total_words' => $translate('Total words'),
            'total_pages' => $translate('Total pages'),
            // Counted inside the Items figure above; surfaced on its own
            // because a curated bibliography of this field is rare enough
            // to be worth naming.
            'references_count' => $translate('References'),
            // dcterms:source — the archives, libraries and personal
            // collections the material was gathered from. Labelled to keep
            // it from reading as a second, smaller newspapers count.
            'unique_sources' => $translate('Archives consulted'),
            'document_types' => $translate('Document types'),
            'audiovisual_minutes' => $translate('Audiovisual minutes'),
            'languages' => $translate('Languages'),
        ];
        $substats = [];
        foreach ($depthFields as $key => $label) {
            if (isset($summary[$key])) {
                $substats[] = ['n' => $summary[$key], 'label' => $label];
            }
        }
        $substats = $substats ?: null;
    }
    ?>
    <div class="banner__content banner__content--<?php echo $escAttr($bannerContentPosition); ?>">
        <?php if ($bannerEyebrow): ?>
            <span class="banner__eyebrow"><?php echo $escHtml($bannerEyebrow); ?></span>
        <?php endif; ?>
        <?php if ($bannerHeading): ?>
            <h1 class="banner__heading"><?php echo $escHtml($bannerHeading); ?></h1>
        <?php endif; ?>
        <?php if ($bannerDescription): ?>
            <p class="banner__description"><?php echo nl2br($escHtml($bannerDescription)); ?></p>
        <?php endif; ?>

        <?php // Hero search — the instrument, in the fold (finding 1.1). ?>
        <div class="banner__search">
            <?php echo $this->partial('common/search-form', ['variant' => 'hero']); ?>
        </div>

        <?php if ($stats): ?>
        <ul class="banner__stats" aria-label="<?php echo $escAttr($translate('Collection at a glance')); ?>">
            <?php foreach ($stats as $stat): ?>
                <li class="banner__stat<?php echo !empty($stat['featured']) ? ' banner__stat--featured' : ''; ?>">
                    <?php // The visible figure + label IS the link's accessible name; a
                          // per-link aria-label would only repeat it less precisely, and
                          // the list already carries the group label. ?>
                    <?php if (!empty($stat['url'])): ?><a class="banner__stat-link" href="<?php echo $escAttr($stat['url']); ?>"><?php endif; ?>
                    <span class="banner__stat-figure"><?php echo $escHtml(number_format((int) $stat['n'], 0, '.', $thin)); ?></span>
                    <span class="banner__stat-label"><?php echo $escHtml($stat['label']); ?></span>
                    <?php if (!empty($stat['url'])): ?></a><?php endif; ?>
                </li>
            <?php endforeach; ?>
        </ul>
        <?php endif; ?>

        <?php if ($substats): ?>
        <ul class="banner__substats" aria-label="<?php echo $escAttr($translate('Corpus in depth')); ?>">
            <?php foreach ($substats as $stat): ?>
                <li class="banner__substat">
                    <span class="banner__substat-figure"><?php echo $escHtml(number_format((int) $stat['n'], 0, '.', $thin)); ?></span>
                    <span class="banner__substat-label"><?php echo $escHtml($stat['label']); ?></span>
                </li>
            <?php endforeach; ?>
        </ul>
        <?php endif; ?>
    </div>
    <?php endif; ?>
</div>
