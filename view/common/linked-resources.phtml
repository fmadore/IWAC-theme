<?php
$this->inlineScript()->appendFile($this->assetUrl('js/dist/linked-resources.min.js'));

// Rendered by core's displaySubjectValues(), which the block template asks for
// one row only (see common/resource-page-block-layout/linked-resources): from
// core this template takes the relation chips ($resourcePropertiesAll), the
// active relation ($resourceType, $propertyId) and the native count. The rows
// it fetches itself:
//
// - Items pointing here — every IWAC relation in practice — come from the
//   API's item search (LinkedResourcesPaging::apiQuery()), so the title search
//   and the sort run over every linked item and the pager pages the result.
// - Media and item sets pointing here keep core's own listing: one page,
//   grouped by relation, with no search or sort to offer.
//
// The block's state lives in its own query parameters — `lr_page`, `lr_q`,
// `lr_sort` and core's `resource_property`, never `page`
// (helper/LinkedResourcesPaging.php says why). So its pager is rendered from
// common/pagination here, not through core's pagination() helper, for two
// reasons:
// - the helper writes `page` into every URL it builds, and its go-to-page
//   form submits `page`;
// - it is one shared instance per request, holding the paginator core's
//   browse controller configured for the page's own listing. Calling it with
//   this block's figures reconfigured that listing's pager too — on an item
//   set's page the ledger, which renders after this block, printed the
//   block's count, page total and #resources-linked fragment.
// Every URL the block builds starts from the current query minus its own
// page, so an active relation filter and search stay live across its pages
// and whatever else the page carries (the ledger's page, its sort) rides along.
$paging = $this->LinkedResourcesPaging($objectResource);
$pageParam = $paging['param'];
$filterParam = $paging['filter'];
$fragment = 'resources-linked';
$url = $this->plugin('url');
$blockUrl = static fn (array $query): string => $url(null, [], ['query' => $query, 'fragment' => $fragment], true);
$perPage = $paging['perPage'];
$page = $paging['page'];
$q = $paging['q'];

$siteId = null;
if ($this->status()->isSiteRequest() && $this->siteSetting('exclude_resources_not_in_site')) {
    $siteId = $this->currentSite()->id();
}

// Set up locale.
$valueLang = null;
if ($this->status()->isSiteRequest()) {
    $lang = $this->lang();
    $filterLocale = (bool) $this->siteSetting('filter_locale_values');
    $valueLang = $filterLocale ? [$lang, ''] : null;
}

$labelMap = [
    'items' => $this->translate('Items'),
    'item_sets' => $this->translate('Item sets'),
    'media' => $this->translate('Media'),
];

$defaultResourceType = null;
foreach ($resourcePropertiesAll as $type => $resourceProperties) {
    if ($resourceProperties) {
        $defaultResourceType = $type;
        break;
    }
}
$defaultResourceProperty = $defaultResourceType ? $defaultResourceType . ':' : null;
$isAllActive = !$resourceProperty || $resourceProperty === $defaultResourceProperty;

// Searching = the active relation is one items hold.
$searching = $resourceType === 'items';
$activeProperty = $searching ? \OmekaTheme\Helper\LinkedResourcesPaging::propertyId((string) $propertyId) : 0;

// Relation chips: one per item property (its labels merged), core's compound
// ids for media and item-set relations — LinkedResourcesPaging::facetChips().
$facetChips = \OmekaTheme\Helper\LinkedResourcesPaging::facetChips(
    $resourcePropertiesAll,
    $this->plugin('translate'),
    $labelMap,
    $searching,
    $activeProperty,
    $resourceProperty
);

// A chip changes the filter and so starts the block over at its first page:
// the current query without the block's page or filter, plus the chip's own.
// The search and the sort stay.
$chipQuery = $paging['query'];
unset($chipQuery[$filterParam]);

$rows = [];
if ($searching) {
    $apiQuery = static fn (int $property, string $search, int $atPage, int $size): array
        => \OmekaTheme\Helper\LinkedResourcesPaging::apiQuery(
            $objectResource->id(), $property, $search, $paging['sortKey'], $atPage, $size, $siteId
        );
    $response = $this->api()->search('items', $apiQuery($activeProperty, $q, $page, $perPage));
    $totalCount = (int) $response->getTotalResults();
    // A page past the last (a stale bookmark, a search that narrowed the
    // set) shows the last page, as core's paginator would.
    $lastPage = \OmekaTheme\Helper\LinkedResourcesPaging::pageCount($totalCount, $perPage);
    if ($page > $lastPage && $totalCount > 0) {
        $page = $lastPage;
        $response = $this->api()->search('items', $apiQuery($activeProperty, $q, $page, $perPage));
    }
    // "All" counts every linked item, whatever the search: chips name the
    // relation sets, the status line the search's result.
    $allCount = (!$activeProperty && $q === '')
        ? $totalCount
        : (int) $this->api()->search('items', $apiQuery(0, '', 1, 1))->getTotalResults();

    // The relation column: every property through which the row points
    // here, as its template labels it.
    foreach ($response->getContent() as $item) {
        $relations = [];
        foreach ($item->values() as $propertyData) {
            foreach ($propertyData['values'] as $value) {
                $linked = $value->valueResource();
                if ($linked && $linked->id() === $objectResource->id()) {
                    $relations[] = $propertyData['alternate_label']
                        ?: $this->translate($propertyData['property']->label());
                    break;
                }
            }
        }
        $rows[] = [
            'resource' => $item,
            'relationLabel' => implode(', ', array_unique($relations)),
        ];
    }
} else {
    $totalCount = (int) $totalCount;
    $allCount = (int) $objectResource->subjectValueTotalCount(null, $defaultResourceType, $siteId);
    // Flatten the grouped subject values into the row shape the shared
    // ledger-table partial expects.
    foreach ($objectResource->subjectValues($page, $perPage, $propertyId, $resourceType, $siteId) as $values) {
        $propertyLabel = $values[0]['property_alternate_label']
            ?: $this->translate($values[0]['property_label']);
        foreach ($values as $value) {
            $rows[] = [
                'resource' => $value['val']->resource(),
                'relationLabel' => $propertyLabel,
            ];
        }
    }
}

$pageCount = \OmekaTheme\Helper\LinkedResourcesPaging::pageCount($totalCount, $perPage);
// As core's paginator does: the pager never names a page past the last.
$currentPage = min(max(1, $page), $pageCount);
$pageUrl = static fn (int $n): string => $blockUrl($paging['query'] + [$pageParam => $n]);

$sortOptions = [
    'date-desc' => $this->translate('Newest first'),
    'date-asc' => $this->translate('Oldest first'),
    'title-asc' => $this->translate('Title (A-Z)'),
    'title-desc' => $this->translate('Title (Z-A)'),
];

$noResultsText = $this->translate('No resources match your search.');
$resultsFoundText = $this->translate('{count} resources found');
$pageResultsText = $this->translate('{count} resources on this page');
?>
<div id="linked-resources"
     class="linked-resources"
     data-total="<?php echo $this->escapeHtmlAttr($totalCount); ?>"
     data-no-results-text="<?php echo $this->escapeHtmlAttr($noResultsText); ?>"
     data-results-found-text="<?php echo $this->escapeHtmlAttr($resultsFoundText); ?>"
     data-page-results-text="<?php echo $this->escapeHtmlAttr($pageResultsText); ?>"
     data-fragment="<?php echo $this->escapeHtmlAttr($fragment); ?>"
     data-query-params="<?php echo $this->escapeHtmlAttr(implode(' ', $paging['params'])); ?>">

    <?php if ($searching): ?>
    <div class="linked-resources__controls">
        <?php echo $this->partial('common/linked-resources-search', [
            'part' => 'form',
            'action' => $url(null, [], ['fragment' => $fragment], true),
            'inputId' => 'linked-resources-search',
            'searchName' => $paging['search'],
            'searchValue' => $q,
            'label' => $this->translate('Search the linked resources by title'),
            'skip' => array_merge($paging['drop'], [$paging['search'], $paging['sort']]),
            'sortId' => 'linked-resources-sort',
            'sortName' => $paging['sort'],
            'sortOptions' => $sortOptions,
            'sortValue' => $paging['sortKey'],
        ]); ?>
    </div>
    <?php endif; ?>

    <?php if ($facetChips): ?>
    <div class="linked-resources__facets"
         role="group"
         aria-label="<?php echo $this->escapeHtmlAttr($this->translate('Filter by relation')); ?>">
        <span class="linked-resources__facets-label">
            <?php echo $this->escapeHtml($this->translate('Filter:')); ?>
        </span>
        <a href="<?php echo $this->escapeHtmlAttr($blockUrl($chipQuery)); ?>"
           class="linked-resources__facet<?php echo $isAllActive ? ' is-active' : ''; ?>"
           <?php echo $isAllActive ? 'aria-current="true"' : ''; ?>>
            <span class="linked-resources__facet-label"><?php echo $this->escapeHtml($this->translate('All')); ?></span>
            <span class="linked-resources__facet-count"><?php echo $this->escapeHtml($allCount); ?></span>
        </a>
        <?php foreach ($facetChips as $chip): ?>
            <?php
            $chipUrl = $blockUrl($chipQuery + [$filterParam => $chip['compound_id']]);
            $chipLabel = implode(' / ', $chip['labels']);
            ?>
            <a href="<?php echo $this->escapeHtmlAttr($chipUrl); ?>"
               class="linked-resources__facet<?php echo $chip['active'] ? ' is-active' : ''; ?>"
               title="<?php echo $this->escapeHtmlAttr($chip['type_label'] . ' — ' . $chipLabel); ?>"
               <?php echo $chip['active'] ? 'aria-current="true"' : ''; ?>>
                <span class="linked-resources__facet-label"><?php echo $this->escapeHtml($chipLabel); ?></span>
            </a>
        <?php endforeach; ?>
    </div>
    <?php endif; ?>

    <?php echo $this->partial('common/linked-resources-search', [
        'part' => 'feedback',
        'noResults' => !$rows,
        'noResultsText' => $noResultsText,
    ]); ?>

    <?php if ($rows): ?>
    <?php echo $this->partial('common/linked-resources-table', [
        'rows' => $rows,
        'showRelation' => true,
        'valueLang' => $valueLang,
    ]); ?>
    <?php endif; ?>

    <?php if ($totalCount > $perPage): ?>
    <div class="linked-footer">
        <?php // The variables core's pagination() helper passes, from this
              // block's own figures and URLs, plus the parameter its
              // go-to-page form writes and the ones that form must drop. ?>
        <?php echo $this->partial('common/pagination', [
            'totalCount' => $totalCount,
            'perPage' => $perPage,
            'currentPage' => $currentPage,
            'previousPage' => $currentPage > 1 ? $currentPage - 1 : null,
            'nextPage' => $currentPage < $pageCount ? $currentPage + 1 : null,
            'pageCount' => $pageCount,
            'query' => $this->params()->fromQuery(),
            'firstPageUrl' => $pageUrl(1),
            'previousPageUrl' => $pageUrl(max(1, $currentPage - 1)),
            'nextPageUrl' => $pageUrl(min($pageCount, $currentPage + 1)),
            'lastPageUrl' => $pageUrl($pageCount),
            'pagelessUrl' => $blockUrl($paging['query']),
            'offset' => ($currentPage - 1) * $perPage,
            'pageParam' => $pageParam,
            'dropParams' => $paging['drop'],
        ]); ?>
    </div>
    <?php endif; ?>

</div>
