<?php
$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');
$escapeAttr = $this->plugin('escapeHtmlAttr');
$decoration = $this->themeSetting('image_decoration');

if ($this->status()->isSiteRequest()) {
    $labelInfo = $this->siteSetting('property_label_information');
    $showLocale = (bool) $this->siteSetting('show_locale_label', true);
    $filterLocale = $this->siteSetting('filter_locale_values');
    $lang = $this->lang();
    $showValueAnnotations = (bool) $this->siteSetting('show_value_annotations', false);
} else {
    $labelInfo = $this->setting('property_label_information');
    $showLocale = true;
    $filterLocale = false;
    $lang = null;
    $showValueAnnotations = true;
}
// Compare languages by primary subtag, never by full string. Value tags in
// this collection are bare ("fr", "en"), but lang() returns whatever the site
// locale is set to — "fr" on the French site and "en-US" on the English one —
// so core's exact strcasecmp can't match an "en" value against "en-US". BCP 47
// subtags are hyphen-separated; Omeka stores the locale with an underscore.
$primarySubtag = static function ($valueLang): string {
    $valueLang = strtolower(trim((string) $valueLang));
    if ($valueLang === '') {
        return '';
    }
    return explode('-', str_replace('_', '-', $valueLang))[0];
};
$siteLang = $primarySubtag($lang);

$filterLocaleCallback = function ($value) use ($primarySubtag, $siteLang) {
    $valueLang = $primarySubtag($value->lang());
    return $valueLang === '' || $valueLang === $siteLang;
};

// Properties whose values are translations of one another rather than distinct
// data: the AI lede carries one "fr" and one "en" rendering of the same
// summary, so printing both on a monolingual site doubles the row for no gain.
// Narrow these to the site's language whenever they *have* a value in it.
//
// Scoped to a named list on purpose. Other properties also come in fr/en pairs
// (dcterms:description, dcterms:alternative), but there a second language can
// be genuine source metadata rather than a translation, so they keep every
// value. Add a term here only when its values are known to be translations.
//
// Deliberately not Omeka's `filter_locale_values` site setting either: that one
// drops every non-matching value across every property, which would silently
// hide French-only source metadata on the English site.
$localePreferredTerms = ['bibo:shortDescription'];

// Untagged (language-neutral) values are always kept; a property with no value
// in the site language keeps all of them. The one thing this drops is a value
// in a third language sitting alongside a site-language sibling — no such pair
// exists in the corpus today (only "fr" and "en" tags are in use).
$preferSiteLangValues = function (array $propertyValues) use ($primarySubtag, $siteLang) {
    if ($siteLang === '') {
        return $propertyValues;
    }
    $hasSiteLang = false;
    foreach ($propertyValues as $value) {
        if ($primarySubtag($value->lang()) === $siteLang) {
            $hasSiteLang = true;
            break;
        }
    }
    if (!$hasSiteLang) {
        return $propertyValues;
    }
    return array_filter($propertyValues, function ($value) use ($primarySubtag, $siteLang) {
        $valueLang = $primarySubtag($value->lang());
        return $valueLang === '' || $valueLang === $siteLang;
    });
};

// Properties whose values are produced by an AI pipeline (LLM summary,
// generated abstract, etc.) — get explicit provenance markup (the EU
// "AI GENERATED" label) so readers can distinguish computational
// artefacts from human-authored metadata. Per "computational honesty."
//
// bibo:shortDescription (the "DescriptionAI" lede) is AI-generated wherever
// it appears. Some terms are only AI-generated under a specific resource
// template — e.g. the table of contents is auto-summarised per page for the
// periodical issues on template 21, whereas a ToC on another template could
// be human-authored — so those are gated by template id.
$aiGeneratedTerms = $this->AiGeneratedTerms(isset($resource) && is_object($resource) ? $resource : null);
?>

<dl>
<?php
foreach ($values as $term => $propertyData):
    // dcterms:title is always rendered as the resource heading (the h1 on
    // show pages, the block heading in the item-with-metadata block, etc.),
    // so skip the duplicate "Title" metadata row.
    if ($term === 'dcterms:title') {
        continue;
    }
    $propertyValues = $propertyData['values'];
    if ($filterLocale) {
        $propertyValues = array_filter($propertyValues, $filterLocaleCallback);
    }
    // True once the property has been narrowed to the site's language, which
    // makes every surviving language tag on it redundant with <html lang>.
    $narrowedToSiteLang = false;
    if (in_array($term, $localePreferredTerms, true)) {
        $preferred = $preferSiteLangValues($propertyValues);
        $narrowedToSiteLang = count($preferred) !== count($propertyValues);
        $propertyValues = $preferred;
    }
    if (!$propertyValues) {
        continue;
    }
    $property = $propertyData['property'];
    $propertyLabel = $propertyData['alternate_label'] ?: $translate($property->label());
    if ('term' === $labelInfo) {
        $propertyTerm = $property->term();
    } elseif ('vocab' === $labelInfo) {
        $propertyTerm = $property->vocabulary()->label();
    } else {
        $propertyTerm = null;
    }
    ?>
    <?php
    $isAiGenerated = in_array($term, $aiGeneratedTerms, true);
    // The EU "AI GENERATED" label already signals provenance, so strip a
    // trailing "AI" from the field label (e.g. "DescriptionAI" → "Description")
    // to avoid the doubled "AI … AI GENERATED" reading.
    $displayLabel = $isAiGenerated ? preg_replace('/\s*AI\s*$/i', '', $propertyLabel) : $propertyLabel;
    ?>
    <div class="property<?php echo $isAiGenerated ? ' property--ai' : ''; ?>" data-property-term="<?php echo $escape($term); ?>">
        <dt>
        <?php echo $escape($displayLabel); ?>
        <?php if ($isAiGenerated): ?>
            <span class="property__ai-eu" role="img" aria-label="<?php echo $escape($translate('AI-generated content')); ?>" title="<?php echo $escape($translate('Generated by an AI model. Verify against the original source.')); ?>"></span>
        <?php endif; ?>
        <?php if ($propertyTerm !== null) : ?>
        <span class="field-term">(<?php echo $escape($propertyTerm); ?>)</span>
        <?php endif; ?>
        </dt>
        <?php foreach ($propertyValues as $value): ?>
            <?php
            $valueType = $value->type();
            $valueLang = $value->lang();
            $valueAnnotation = $value->valueAnnotation();
            $class = ['value'];
            if ('resource' == $valueType || strpos($valueType, 'resource') !== false) {
                // The target can be null when the anonymous user can't see it.
                $valueResource = $value->valueResource();
                $class[] = 'resource';
                if ($valueResource) {
                    $class[] = $escape($valueResource->resourceName());

                    if ('media' == $valueResource->resourceName() && is_array($decoration) && in_array('media', $decoration)) {
                        $class[] = 'decoration decoration--thumbnail';
                    }
                }
            } elseif ('uri' == $valueType) {
                $class[] = 'uri';
            }
            // The AI table of contents is a deterministic per-article index; parse
            // it into structured markup (common/ai-toc) instead of a raw text dump.
            $isAiTocValue = $isAiGenerated && 'dcterms:tableOfContents' === $term && 'literal' === $valueType;
            ?>
            <?php // Only emit lang when set — lang="" resets the language to
                  // *unknown*, overriding the document language on every
                  // untagged value (screen readers lose FR/EN pronunciation). ?>
            <dd class="<?php echo implode(' ', $class); ?>"<?php echo $valueLang ? ' lang="' . $escapeAttr($valueLang) . '"' : ''; ?>>
                <?php // On a narrowed property the chip would just restate
                      // <html lang>; everywhere else it still marks a value
                      // that departs from the page language, so it stays. ?>
                <?php if ($showLocale && $valueLang && !$isAiTocValue && !($narrowedToSiteLang && $primarySubtag($valueLang) === $siteLang)) : ?>
                    <span class="language"><?php echo $escape($valueLang); ?></span>
                <?php endif; ?>
                <?php if ($isAiTocValue): ?>
                    <?php echo $this->partial('common/ai-toc', ['text' => (string) $value->value()]); ?>
                <?php else: ?>
                    <span class="value-content" dir="auto"><?php echo $filterLocale ? $value->asHtml($lang) : $value->asHtml(); ?></span>
                <?php endif; ?>
                <?php if(!$value->isPublic()) : ?>
                    <span class="o-icon-private" role="img" title="<?php echo $this->escapeHtml($translate('Private')); ?>" aria-label="<?php echo $this->escapeHtml($translate('Private')); ?>"></span>
                <?php endif; ?>
                <?php if ($valueAnnotation && $showValueAnnotations) : ?>
                    <?php
                    $annotationId = 'value-annotation-' . spl_object_id($valueAnnotation);
                    $annotationHeadingId = $annotationId . '-heading';
                    ?>
                    <div class="annotation-btn">
                        <button type="button" class="annotation-trigger" aria-expanded="false" aria-controls="<?php echo $escapeAttr($annotationId); ?>" aria-label="<?php echo $this->escapeHtml($translate('Show annotation')); ?>">
                            <span class="o-icon-annotation" aria-hidden="true"></span>
                        </button>
                        <div id="<?php echo $escapeAttr($annotationId); ?>" class="annotation-tooltip" role="region" aria-labelledby="<?php echo $escapeAttr($annotationHeadingId); ?>" aria-hidden="true">
                            <div class="annotation-tooltip__wrapper">
                                <h6 id="<?php echo $escapeAttr($annotationHeadingId); ?>" class="annotation-tooltip__heading"><?php echo $this->escapeHtml($translate('Value Annotations')); ?></h6>
                                <?php echo $valueAnnotation->displayValues(); ?>
                            </div>
                        </div>
                    </div>
                <?php endif; ?>
                <?php $this->trigger('view.show.value', ['value' => $value]); ?>
            </dd>
        <?php endforeach; ?>
    </div>
<?php endforeach; ?>
</dl>
