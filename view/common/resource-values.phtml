<?php
$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');
$escapeAttr = $this->plugin('escapeHtmlAttr');
$decoration = $this->themeSetting('image_decoration');

// Which values show, in which language, under which label, and how a long
// transcript folds: helper/ResourceValues.php, where each rule is documented
// and tested (test/php/run.php). This template is the markup.
$rv = \OmekaTheme\Helper\ResourceValues::class;

$context = $this->ResourceValues(isset($resource) && is_object($resource) ? $resource : null);
$labelInfo = $context['labelInfo'];
$showLocale = $context['showLocale'];
$filterLocale = $context['filterLocale'];
$lang = $context['lang'];
$showValueAnnotations = $context['showValueAnnotations'];
$siteLang = $context['siteLang'];
$aiGeneratedTerms = $context['aiGeneratedTerms'];
$recordLang = $context['recordLang'];
?>

<dl>
<?php
foreach ($values as $term => $propertyData):
    // dcterms:title is always rendered as the resource heading (the h1 on
    // show pages, the block heading in the item-with-metadata block, etc.),
    // so skip the duplicate "Title" metadata row.
    if ($term === 'dcterms:title') {
        continue;
    }
    $propertyValues = $propertyData['values'];
    if ($filterLocale) {
        $propertyValues = $rv::filterToSiteLanguage($propertyValues, $siteLang);
    }
    // $narrowedToSiteLang: every surviving language tag repeats <html lang>.
    [$propertyValues, $narrowedToSiteLang] = $rv::preferSiteLanguage($propertyValues, $siteLang, $term);
    if (!$propertyValues) {
        continue;
    }
    $property = $propertyData['property'];
    $propertyLabel = $propertyData['alternate_label'] ?: $translate($property->label());
    if ('term' === $labelInfo) {
        $propertyTerm = $property->term();
    } elseif ('vocab' === $labelInfo) {
        $propertyTerm = $property->vocabulary()->label();
    } else {
        $propertyTerm = null;
    }
    ?>
    <?php
    $isAiGenerated = in_array($term, $aiGeneratedTerms, true);
    $displayLabel = $rv::displayLabel((string) $propertyLabel, $isAiGenerated);
    ?>
    <div class="property<?php echo $isAiGenerated ? ' property--ai' : ''; ?>" data-property-term="<?php echo $escape($term); ?>">
        <dt>
        <?php echo $escape($displayLabel); ?>
        <?php if ($isAiGenerated): ?>
<?php // The caveat is the important half of this mark, and it used to live only
                  // in `title` — mouse-hover-only, unreachable by keyboard or touch. It is
                  // part of the accessible name now; `title` stays for the pointer tooltip. ?>
            <span class="property__ai-eu" role="img" aria-label="<?php echo $escape($translate('AI-generated content — verify against the original source.')); ?>" title="<?php echo $escape($translate('Generated by an AI model. Verify against the original source.')); ?>"></span>
        <?php endif; ?>
        <?php if ($propertyTerm !== null) : ?>
        <span class="field-term">(<?php echo $escape($propertyTerm); ?>)</span>
        <?php endif; ?>
        </dt>
        <?php foreach ($propertyValues as $value): ?>
            <?php
            $valueType = $value->type();
            $valueLang = $value->lang();
            $valueAnnotation = $value->valueAnnotation();
            $valueResource = null;
            $class = ['value'];
            if ('resource' == $valueType || strpos($valueType, 'resource') !== false) {
                // The target can be null when the anonymous user can't see it.
                $valueResource = $value->valueResource();
                $class[] = 'resource';
                if ($valueResource) {
                    $class[] = $escape($valueResource->resourceName());

                    if ('media' == $valueResource->resourceName() && is_array($decoration) && in_array('media', $decoration)) {
                        $class[] = 'decoration decoration--thumbnail';
                    }
                }
            } elseif ('uri' == $valueType) {
                $class[] = 'uri';
            }
            // The AI table of contents is a deterministic per-article index; parse
            // it into structured markup (common/ai-toc) instead of a raw text dump.
            $isAiTocValue = $isAiGenerated && 'dcterms:tableOfContents' === $term && 'literal' === $valueType;
            // A DOI or a Wikidata entity: printed with its scheme's mark and
            // the canonical link (helper/ExternalIdentifier.php).
            $externalId = $this->ExternalIdentifier($value, $term);
            // Long OCR body: an opening extract, the rest in a <details>.
            $transcript = 'literal' === $valueType && $rv::TRANSCRIPT_TERM === $term
                ? $rv::transcript($term, $valueType, (string) $value->value())
                : null;
            // The record's language on its own untagged prose. The elements
            // below already carry dir="auto", so this adds only lang. It goes
            // on the text, not the <dd>: the row also carries site chrome (the
            // full-text toggle, the annotation button) in the page's language.
            $proseLang = $rv::proseLang($recordLang, $valueLang, (string) $valueType, $term);
            $proseLangAttr = $proseLang !== '' ? ' lang="' . $escapeAttr($proseLang) . '"' : '';
            ?>
            <?php // Only emit lang when set — lang="" resets the language to
                  // *unknown*, overriding the document language on every
                  // untagged value (screen readers lose FR/EN pronunciation). ?>
            <dd class="<?php echo implode(' ', $class); ?>"<?php echo $valueLang ? ' lang="' . $escapeAttr($valueLang) . '"' : ''; ?>>
                <?php // On a narrowed property the chip would just restate
                      // <html lang>; everywhere else it still marks a value
                      // that departs from the page language, so it stays. ?>
                <?php if ($rv::showLanguageChip($showLocale, $valueLang, $isAiTocValue, $narrowedToSiteLang, $siteLang)) : ?>
                    <span class="language"><?php echo $escape($valueLang); ?></span>
                <?php endif; ?>
                <?php if ($isAiTocValue): ?>
                    <?php echo $this->partial('common/ai-toc', ['text' => (string) $value->value()]); ?>
                <?php elseif ($transcript !== null): ?>
                    <?php [$transcriptLede, $transcriptRest, $transcriptRestWords] = $transcript; ?>
                    <div class="transcript">
                        <div class="transcript__lede value-content" dir="auto"<?php echo $proseLangAttr; ?>><?php echo nl2br($escape($transcriptLede)); ?></div>
                        <details class="transcript__rest">
                            <summary class="transcript__toggle">
                                <span class="transcript__toggle-label transcript__toggle-label--more"><?php
                                    echo $escape(sprintf(
                                        $translate('Read the full text — %s more words'),
                                        $rv::formatCount($transcriptRestWords)
                                    ));
                                ?></span>
                                <span class="transcript__toggle-label transcript__toggle-label--less"><?php
                                    echo $escape($translate('Collapse the full text'));
                                ?></span>
                            </summary>
                            <div class="transcript__body value-content" dir="auto"<?php echo $proseLangAttr; ?>><?php echo nl2br($escape($transcriptRest)); ?></div>
                        </details>
                    </div>
                <?php elseif ($externalId !== null): ?>
                    <?php // The mark is the scheme's name ("Wikidata Q141697087"):
                          // the label alone would leave a bare QID in the link's
                          // accessible name. The identifier is machine text, so
                          // it is kept left-to-right and out of page translation. ?>
                    <span class="value-content"><a class="uri-value-link ext-id ext-id--<?php echo $escapeAttr($externalId['scheme']); ?>" href="<?php echo $escapeAttr($externalId['url']); ?>" target="_blank" rel="noopener" dir="ltr"><span class="ext-id__mark" role="img" aria-label="<?php echo $escapeAttr($externalId['label']); ?>" title="<?php echo $escapeAttr($externalId['label']); ?>"></span><span class="ext-id__id" translate="no"><?php echo $escape($externalId['id']); ?></span></a></span>
                <?php else: ?>
                    <?php
                    $valueHtml = $filterLocale ? $value->asHtml($lang) : $value->asHtml();
                    // Core's linkPretty('square') crops a wide logo to its middle;
                    // show the uncropped medium derivative instead.
                    $valueHtml = $rv::mediumThumbnails((string) $valueHtml, $valueResource, $escapeAttr);
                    ?>
                    <span class="value-content" dir="auto"<?php echo $proseLangAttr; ?>><?php echo $valueHtml; ?></span>
                <?php endif; ?>
                <?php if(!$value->isPublic()) : ?>
                    <span class="o-icon-private" role="img" title="<?php echo $this->escapeHtml($translate('Private')); ?>" aria-label="<?php echo $this->escapeHtml($translate('Private')); ?>"></span>
                <?php endif; ?>
                <?php if ($valueAnnotation && $showValueAnnotations) : ?>
                    <?php
                    // The annotation's own id, not spl_object_id(): each
                    // valueAnnotation() call builds a fresh representation, and
                    // once the previous iteration's is freed PHP reuses its
                    // object id — three annotated values rendered ids 1, 2, 1,
                    // pointing aria-controls/aria-labelledby at the wrong panel.
                    $annotationId = 'value-annotation-' . (int) $valueAnnotation->id();
                    $annotationHeadingId = $annotationId . '-heading';
                    ?>
                    <div class="annotation-btn">
                        <button type="button" class="annotation-trigger" aria-expanded="false" aria-controls="<?php echo $escapeAttr($annotationId); ?>" aria-label="<?php echo $this->escapeHtml($translate('Show annotation')); ?>">
                            <span class="o-icon-annotation" aria-hidden="true"></span>
                        </button>
                        <div id="<?php echo $escapeAttr($annotationId); ?>" class="annotation-tooltip" role="region" aria-labelledby="<?php echo $escapeAttr($annotationHeadingId); ?>" aria-hidden="true">
                            <div class="annotation-tooltip__wrapper">
<?php // Deliberately not a heading. This label was an <h6> that opened a
                                      // region nested inside a <dd>, so expanding an annotation injected
                                      // an orphan h6 into the page outline ahead of its first h2. The
                                      // region is still named — aria-labelledby works on any element. ?>
                                <p id="<?php echo $escapeAttr($annotationHeadingId); ?>" class="annotation-tooltip__heading"><?php echo $this->escapeHtml($translate('Value Annotations')); ?></p>
                                <?php echo $valueAnnotation->displayValues(); ?>
                            </div>
                        </div>
                    </div>
                <?php endif; ?>
                <?php $this->trigger('view.show.value', ['value' => $value]); ?>
            </dd>
        <?php endforeach; ?>
    </div>
<?php endforeach; ?>
</dl>
