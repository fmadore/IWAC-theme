<?php
$translate = $this->plugin('translate');
$navDepthSetting = (int) $this->themeSetting('nav_depth');
$navDepth = $navDepthSetting ? $navDepthSetting - 1 : -1;
?>

<header class="main-header">

	<?php echo $userBar; ?>

	<?php // Masthead row: wordmark left, research tools right. The class
	      // main-header__main-bar is load-bearing — navigation.js uses it as
	      // the focus-trap container for the menu drawer. ?>
	<div class="main-header__main-bar container">
		<div class="main-header__site-title">
			<?php
			// On narrow screens the wordmark swaps to the admin-set acronym
			// (IWAC / CIAO) instead of truncating mid-word. The full title
			// stays in the DOM (visually hidden) as the link's accessible
			// name; the acronym is presentation only.
			$siteAcronym = trim((string) $this->themeSetting('site_title_acronym'));
			?>
			<a href="<?php echo $this->escapeHtmlAttr($site->url()); ?>"><?php if ($siteAcronym): ?><span class="main-header__site-title-full"><?php echo $this->escapeHtml($site->title()); ?></span><span class="main-header__site-title-acronym" aria-hidden="true"><?php echo $this->escapeHtml($siteAcronym); ?></span><?php else: echo $this->escapeHtml($site->title()); endif; ?></a>
		</div>
		<div class="main-header__tools">
			<div class="main-header__search-form">
				<?php echo $this->partial('common/search-form'); ?>
			</div>
			<div class="main-header__utilities">
				<?php // Language Switcher — requires the Internationalisation module.
				      // Guard the call: the module's languageSwitcher() helper resolves the
				      // current page's translations via $api->read('site_pages', …), which
				      // throws NotFoundException when the page is missing. On the 404 error
				      // page that throw fires *during* error rendering and escalates a clean
				      // 404 into a 500 (so crawlers never drop the dead URL). The switcher is
				      // non-essential chrome — swallow it and render nothing on routes that
				      // can't resolve a page; real pages are unaffected. ?>
				<?php if ($this->getHelperPluginManager()->has('languageSwitcher')): ?>
					<?php try { echo $this->languageSwitcher(); } catch (\Throwable $e) {} ?>
				<?php endif; ?>
				<?php // All three icons (system / light / dark) render; CSS selects one based on
				      // body[data-theme-mode]. The head-script in layout.phtml sets data-theme-mode
				      // before first paint, so the correct icon is shown synchronously
				      // and there's no flash-of-wrong-icon for users with prefers-color-scheme: dark. ?>
				<button class="theme-toggle" data-theme-toggle type="button"
					data-label-system="<?php echo $this->escapeHtmlAttr($translate('System theme active. Activate to switch to light mode.')); ?>"
					data-label-light="<?php echo $this->escapeHtmlAttr($translate('Light theme active. Activate to switch to dark mode.')); ?>"
					data-label-dark="<?php echo $this->escapeHtmlAttr($translate('Dark theme active. Activate to switch to system theme.')); ?>"
					data-state-system="<?php echo $this->escapeHtmlAttr($translate('System theme')); ?>"
					data-state-light="<?php echo $this->escapeHtmlAttr($translate('Light theme')); ?>"
					data-state-dark="<?php echo $this->escapeHtmlAttr($translate('Dark theme')); ?>"
					aria-label="<?php echo $this->escapeHtmlAttr($translate('System theme active. Activate to switch to light mode.')); ?>">
					<?php // Lucide glyphs as masks (components/header/_theme-toggle.scss):
					      // contrast = follow the system, sun = light, moon = dark. ?>
					<span class="theme-toggle__icon theme-toggle__icon--auto" aria-hidden="true"></span>
					<span class="theme-toggle__icon theme-toggle__icon--light" aria-hidden="true"></span>
					<span class="theme-toggle__icon theme-toggle__icon--dark" aria-hidden="true"></span>
				</button>
				<?php // Polite live region: theme-toggle.js writes the new state here
				      // after a user toggle so screen readers announce the change. ?>
				<span class="sr-only" data-theme-status role="status" aria-live="polite"></span>

				<?php // The PWA install control lives in the footer (common/footer.phtml),
				      // not here: on a 375px phone the masthead already carries search,
				      // language, theme and the hamburger, and a fifth control squeezed
				      // the wordmark. Installing is a once-ever action — it doesn't need
				      // masthead real estate on every page. ?>
			</div>
			<button type="button" class="main-navigation__toggle" aria-expanded="false" aria-controls="menu-drawer">
				<span class="sr-only"><?php echo $translate('Open menu'); ?></span>
				<span aria-hidden="true"></span>
				<span aria-hidden="true"></span>
				<span aria-hidden="true"></span>
			</button>
		</div>
	</div>

	<?php // Section strip: the full research IA as a newspaper section bar.
	      // Visible from $lg; below that the drawer (hamburger above) serves it. ?>
	<nav class="main-navigation" aria-label="<?php echo $this->escapeHtmlAttr($translate('Main navigation')); ?>">
		<div class="main-navigation__container container">
			<?php
			echo $site->publicNav()->menu()->renderMenu(null, [
				'addClassToListItem' => true,
				'maxDepth' => $navDepth
			]);
			?>
		</div>
	</nav>

	<?php // Mobile section tabs — below $lg the section strip is hidden, so
	      // surface the research IA as a horizontally-scrollable tab row here
	      // (top-level items only) instead of burying it all in the drawer.
	      // A distinct class (NOT .main-navigation) so navigation.js leaves it
	      // alone — the hamburger drawer still carries the full menu. ?>
	<nav class="section-tabs" aria-label="<?php echo $this->escapeHtmlAttr($translate('Browse sections')); ?>">
		<div class="section-tabs__scroll container">
			<?php echo $site->publicNav()->menu()->renderMenu(null, ['addClassToListItem' => true, 'maxDepth' => 0]); ?>
		</div>
	</nav>

</header>

<?php // Menu drawer placed outside header to avoid backdrop-filter containing block issues ?>
<?php echo $this->partial('common/menu-drawer'); ?>
