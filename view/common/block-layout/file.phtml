<?php
$hyperlink  = $this->plugin('hyperlink');
$decoration = $this->themeSetting('image_decoration');
$classes    = $classes ?? [];
if (isset($alignmentClass)) {
    $classes[] = $alignmentClass;
    $classes[] = 'file';
}
?>

<div class="<?php echo $this->escapeHtml(implode(' ', $classes)); ?>">
    <?php foreach($attachments as $attachment): ?>
        <?php $item = $attachment->item(); ?>
        <?php if (empty($item)) continue; ?>
        <div class="item resource <?php echo is_array($decoration) && in_array('media', $decoration) ? 'decoration' : ''; ?>">
            <?php
            $media = $attachment->media() ?: $item->primaryMedia();
            if ($media):
                if ($mediaDisplay === 'thumbnail') {
                    switch ($link) {
                        case 'original':
                            $url = $media->originalUrl();
                            break;
                        case 'item':
                            $url = $item->url();
                            break;
                        case 'media':
                            $url = $media->url();
                            break;
                        default:
                            throw new \InvalidArgumentException(sprintf('Invalid link type "%s"', $link));
                    }
                    // Core's thumbnail() takes its alt from the media's alt
                    // text, which most of this corpus lacks, so the link's only
                    // content was an alt="" image: a link with no name. When the
                    // title below links the same item, the image link is a
                    // duplicate for the pointer and is taken out of the keyboard
                    // and accessibility trees (as the carousel's plate is);
                    // otherwise it is named after what it opens.
                    $duplicatesTitle = $link === 'item' && $showTitleOption === 'item_title';
                    $linkAttributes = $duplicatesTitle
                        ? ['tabindex' => '-1', 'aria-hidden' => 'true']
                        : ['aria-label' => $link === 'item' ? $item->displayTitle() : $media->displayTitle()];
                    echo $hyperlink->raw($this->thumbnail($media, $thumbnailType), $url, $linkAttributes);
                } else {
                    echo $media->render([
                        'thumbnailType' => $thumbnailType,
                        'link' => $link,
                    ]);
                }
            endif;
            ?>
            <?php if ($showTitleOption === 'item_title'): ?>
                <h3><?php echo $item->link($item->displayTitle()); ?></h3>
            <?php elseif ($showTitleOption === 'file_name' && $media): ?>
                <h3><?php echo $this->escapeHtml($media->displayTitle()); ?></h3>
            <?php endif; ?>
            <?php $caption = $attachment->caption(); ?>
            <?php if ($caption): ?>
                <div class="caption"><?php echo $caption; ?></div>
            <?php endif; ?>
        </div>
    <?php endforeach; ?>
</div>
