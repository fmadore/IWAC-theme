<?php
$decoration = $this->themeSetting('image_decoration');
?>

<div class="item-showcase">
<?php foreach ($attachments as $attachment): ?>
    <div class="item resource">
    <?php
    $item = $attachment->item();
    $caption = $attachment->caption();
    if ($item):
        $media = $attachment->media() ?: $item->primaryMedia();
        // When the title is shown as a link, the image link is a duplicate
        // door: keep it out of the tab order and the accessibility tree, with
        // an empty alt (it repeated the title, announcing each item twice).
        // Without the title link it is the only link, and it is named.
        $titleIsLinked = $this->showTitleOption == 'item_title';
        if ($media):
            $mediaClass = 'item-showcase__media';
            if (is_array($decoration) && in_array('media', $decoration)) {
                $mediaClass .= ' decoration';
            }
            $mediaAlt = '';
            if (!$titleIsLinked) {
                $mediaAlt = method_exists($media, 'altText') ? (string) $media->altText() : '';
                $mediaAlt = $mediaAlt ?: $item->displayTitle();
            }
            $mediaLinkAttribs = ['class' => $mediaClass];
            if ($titleIsLinked) {
                $mediaLinkAttribs += ['tabindex' => '-1', 'aria-hidden' => 'true'];
            }
            echo $item->linkRaw($this->thumbnail($media, $this->thumbnailType, ['alt' => $mediaAlt]), null, $mediaLinkAttribs);
        endif;
        ?>
        <div class="item-showcase__content">
            <?php echo $this->ResourceTags($item); ?>
            <div class="item-showcase__text">
                <?php $showTitleOption = $this->showTitleOption; ?>
                <?php if ($showTitleOption == 'item_title'): ?>
                    <h3><?php echo $item->link($item->displayTitle()); ?></h3>
                <?php elseif ($showTitleOption == 'file_name' && $media): ?>
                    <h3><?php echo $this->escapeHtml($media->displayTitle()); ?></h3>
                <?php endif; ?>
                <?php if ($caption): ?>
                    <div class="caption"><?php echo $caption; ?></div>
                <?php endif; ?>
            </div>
        </div>
    <?php endif; ?>
    </div>
<?php endforeach; ?>
</div>
