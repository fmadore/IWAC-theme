<?php
$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');
$escapeAttr = $this->plugin('escapeHtmlAttr');
// Counts grouped with U+202F, as in the homepage stat strip and the
// transcript toggle — "1–25 of 12 345", not "of 12345". Locale-neutral, and
// never a comma a French reader would take for a decimal mark.
$figure = static fn ($n): string => number_format((int) $n, 0, '.', "\u{202F}");
// The query parameter the go-to-page form writes. Core's pagination() helper
// renders this partial for the page's own listing, which pages through
// `page`, and passes no $pageParam; the Linked resources block renders it
// with `lr_page` (helper/LinkedResourcesPaging.php), so the two pagers an
// item set's page can carry never write each other's parameter. $dropParams:
// further parameters the form must not carry over from the current query.
$pageParam = isset($pageParam) ? (string) $pageParam : 'page';
$dropParams = isset($dropParams) ? array_values((array) $dropParams) : [];
?>
<nav class="pagination" aria-label="<?php echo $escapeAttr($translate('Pagination')); ?>">
    <?php if ($totalCount): ?>

        <?php
        $from = $offset + 1;
        $to = ($currentPage < $pageCount) ? $offset + $perPage : $totalCount;
        ?>

        <?php if ($pageCount > 1): ?>

            <div class="pager-wrapper">
                <span class="row-count"><?php echo sprintf($escape($translate('%1$s–%2$s of %3$s')), $figure($from), $figure($to), $figure($totalCount)); ?></span>

                <!-- Prev Button -->
                <?php if ($currentPage != 1): ?>
                    <?php echo $this->hyperlink('', $previousPageUrl, ['class' => 'pagination-nav previous o-icon-prev', 'title' => $translate('Previous'), 'aria-label' => $translate('Previous')]); ?>
                <?php else: ?>
                    <span class="pagination-nav previous o-icon-prev disabled" aria-hidden="true"></span>
                <?php endif; ?>

                <!-- Pager -->
                <?php // No id on the input: two paginations can share a page
                      // (browse + linked resources); the wrapping label names it. ?>
                <form class="pager" method="GET" action="">
                    <?php echo $this->queryToHiddenInputs(array_merge([$pageParam], $dropParams)); ?>
                    <label>
                        <?php echo $escape($translate('Page')); ?>
                        <input type="text" name="<?php echo $escapeAttr($pageParam); ?>" class="page-input-top" value="<?php echo $escapeAttr($currentPage); ?>" size="4" aria-label="<?php echo $escapeAttr($translate('Page')); ?>">
                    </label>
                    <span class="page-count"><?php echo sprintf($escape($translate('of %s')), $figure($pageCount)); ?></span>
                    <button type="submit" class="pagination-nav gotopage-btn" aria-label="<?php echo $escapeAttr($translate('Go')); ?>"><span class="sr-only"><?php echo $escape($translate('Go')); ?></span></button>
                </form>

                <!-- Next Button -->
                <?php if ($currentPage < $pageCount): ?>
                    <?php echo $this->hyperlink('', $nextPageUrl, ['class' => 'pagination-nav next o-icon-next', 'title' => $translate('Next'), 'aria-label' => $translate('Next')]); ?>
                <?php else: ?>
                    <span class="pagination-nav next o-icon-next disabled" aria-hidden="true"></span>
                <?php endif; ?>
            </div>

        <?php else: ?>
            <span class="row-count"><?php echo sprintf($escape($translate('%1$s–%2$s of %3$s')), $figure($from), $figure($to), $figure($totalCount)); ?></span>
        <?php endif; ?>

    <?php else: ?>
        <?php echo $escape($translate('0 results')); ?>
    <?php endif; ?>
</nav>
