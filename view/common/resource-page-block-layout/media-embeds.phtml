<?php
$decoration = $this->themeSetting('image_decoration');

// Two media kinds are rendered by dedicated blocks and skipped here, so an item
// with both blocks enabled never gets two players over the same source: web
// archives (`webArchive`, web-archive.phtml) and YouTube media (`videoEmbeds`,
// video-embeds.phtml). Which block owns a media is decided in one place,
// helper/MediaKind.php; this block keeps the VIEWER kind.
$mediaKind = $this->plugin('MediaKind');
$resourceMedia = [];
foreach ($resource->media() as $media) {
    if ($mediaKind($media) === $mediaKind::VIEWER) {
        $resourceMedia[] = $media;
    }
}
?>
<?php if ($resourceMedia): ?>
<div class="media-embeds <?php echo is_array($decoration) && in_array('media', $decoration) ? 'decoration' : ''; ?>">
    <?php foreach ($resourceMedia as $media): ?>
    <?php echo $media->render(); ?>
    <?php endforeach; ?>
</div>
<?php endif; ?>
