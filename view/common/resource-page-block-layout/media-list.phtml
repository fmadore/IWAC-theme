<?php
$resourceMedia = $resource->media();
$decoration = $this->themeSetting('image_decoration');
?>
<?php if ($resourceMedia): ?>
<dl class="media-list">
    <div class="property">
        <dt><?php echo $this->translate('Media'); ?></dt>
        <?php foreach ($resourceMedia as $media): ?>
        <?php
        $altText = '';
        if (method_exists($media, 'altText')) {
            $altText = (string) $media->altText();
        }
        if (!$altText) {
            $altText = $media->displayTitle();
        }
        ?>
        <dd class="value <?php echo is_array($decoration) && in_array('media', $decoration) ? 'decoration decoration--thumbnail' : ''; ?>">
            <?php // Lazy: this list sits below the viewer and the metadata, and a
                  // periodical issue carries one media per page — a dozen or more
                  // eager thumbnail fetches competing with the page's own LCP. ?>
            <?php echo $media->linkRaw($this->thumbnail($media, 'square', ['alt' => $altText, 'loading' => 'lazy', 'decoding' => 'async'])); ?>
        </dd>
        <?php endforeach; ?>
    </div>
</dl>
<?php endif; ?>
