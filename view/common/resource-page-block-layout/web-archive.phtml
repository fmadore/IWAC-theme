<?php
/**
 * Web archive block — renders the ReplayWeb.page player for any web-archive
 * media on this item, and nothing at all when there is no capture, so the block
 * can sit in the default stack without leaving an empty heading everywhere.
 *
 * This emits <replay-web-page> directly rather than calling $media->render(),
 * because the WebArchive module's own template sets none of the attributes
 * below and offers no way to pass them:
 *
 *   newWindowBase  Sets baseUrlSourcePrefix. Archived press pages carry ad and
 *                  social scripts that open a new context; the service worker
 *                  answers that with makeTopFrame(), which redirects to
 *                  baseUrlSourcePrefix + "?source=…#url=…&view=replay". The
 *                  player defaults that to "https://replayweb.page/" whenever
 *                  nobody sets it, so the visitor lands on a third-party origin
 *                  that has no copy of the collection, 404s its own API, then
 *                  fails to load our .wacz cross-origin: "Unexpected Loading
 *                  Error". Pointing it at our own shell keeps the escape
 *                  same-origin and working.
 *   coll           Pins the collection id. Without it the id is a hash of the
 *                  source URL, and the player freezes a collection's config
 *                  into the collDB IndexedDB store on FIRST load and reuses it
 *                  forever — so a returning visitor keeps whatever
 *                  baseUrlSourcePrefix was in force the first time, and no
 *                  amount of redeploying changes it. Bumping $collVersion below
 *                  mints a new id, which is the only reliable way to roll out a
 *                  config change without asking every visitor to clear storage.
 *   sandbox        Defence in depth against a plain top-level frame-bust. It is
 *                  NOT what fixes the above: the list the player applies allows
 *                  popups, and it pairs allow-scripts with allow-same-origin,
 *                  which browsers warn can be self-removed.
 *
 * Trade-off: bypassing the module renderer also bypasses its assertPlayable()
 * guard, which refuses to render when the file is served with Content-Encoding.
 * Range requests are what the player actually uses and those are never
 * compressed, so this is acceptable — but if playback breaks after a server
 * change, check for Content-Encoding on the .wacz first.
 *
 * Web-archive media are excluded from media-embeds.phtml so the two blocks can
 * never both mount a player over the same file. A site that does not enable
 * this block (Admin → Themes → Configure resource pages) renders no captures.
 *
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Omeka\Api\Representation\ItemRepresentation $resource
 */

$archives = [];
foreach ($resource->media() as $media) {
    // Mirrors WebArchive\Module::MEDIA_TYPES. The module plays both formats
    // through the same viewer, so matching only 'application/wacz' would
    // silently drop a .warc upload.
    if (in_array($media->mediaType(), ['application/wacz', 'application/warc'], true)) {
        $archives[] = $media;
    }
}

if (!$archives):
    return;
endif;

// Bump on ANY change to the player attributes below. The config a collection
// was first loaded with is persisted in IndexedDB and reused indefinitely;
// changing the collection id is what forces returning visitors onto the new one.
$collVersion = 'v2';

// No version query on the base: it is a directory the player's service worker
// serves the app shell from, not a file.
$replayBase = $this->assetUrl('vendor/replaywebpage/', 'WebArchive', false, false);
$this->headLink()->appendStylesheet($this->assetUrl('css/web-archive.css', 'WebArchive'));
$this->headScript()->appendFile($this->assetUrl('vendor/replaywebpage/ui.js', 'WebArchive'));
?>
<div id="web-archive" class="web-archive">
    <div class="web-archive__header">
        <h3 class="web-archive__heading">
            <?php echo $this->translatePlural('Archived web page', 'Archived web pages', count($archives)); ?>
        </h3>
    </div>
    <?php foreach ($archives as $media): ?>
    <?php
    $mediaData = $media->mediaData() ?? [];
    $startUrl = $mediaData['start_url'] ?? null;
    // Same fallback order as the module's renderer: per-media, then site-wide.
    $embedMode = $mediaData['embed_mode'] ?? $this->setting('webarchive_embed_mode', 'default');
    ?>
    <replay-web-page
        source="<?php echo $this->escapeHtmlAttr($media->originalUrl()); ?>"
        replayBase="<?php echo $this->escapeHtmlAttr($replayBase); ?>"
        newWindowBase="<?php echo $this->escapeHtmlAttr($replayBase); ?>"
        coll="<?php echo $this->escapeHtmlAttr('iwac-' . $media->id() . '-' . $collVersion); ?>"
        sandbox
        <?php if ($startUrl): ?>url="<?php echo $this->escapeHtmlAttr($startUrl); ?>"<?php endif; ?>
        embed="<?php echo $this->escapeHtmlAttr($embedMode); ?>"
        style="width:100%;height:600px;display:block;">
    </replay-web-page>
    <?php endforeach; ?>
</div>
