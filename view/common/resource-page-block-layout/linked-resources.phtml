<?php
// The block's state — its page (`lr_page`, never core's `page`), relation
// filter, title search and sort — is decided in one place,
// helper/LinkedResourcesPaging.php, for this template and
// common/linked-resources alike. Helper names are case-sensitive on the
// server: this must match config/theme.ini's helpers[] spelling exactly.
//
// Core is asked for one row only. displaySubjectValues() is still the entry
// point because it is the only public source of the relation chips (which
// properties point here, from which resource types) and of the native count;
// the rows themselves are fetched by common/linked-resources — through the
// API's item search, which can search and sort every linked item, or, for
// media and item sets pointing here, through core's own paging. Asking core
// for its usual 25 would hydrate 25 values nobody renders.
$paging = $this->LinkedResourcesPaging($resource);
$options = [
    'page' => 1,
    'perPage' => 1,
    'resourceProperty' => $paging['resourceProperty'],
];
if ($this->siteSetting('exclude_resources_not_in_site')) {
    $options['siteId'] = $this->currentSite()->id();
}
$subjectValues = $resource->displaySubjectValues($options);
?>
<?php if ($subjectValues): ?>
<div id="resources-linked" class="resources-linked">
    <?php // h2, not h3. This is a top-level section of the item page, a sibling of
          // "How to cite" (h2) — and on records that carry no citation block (the
          // authority records, e.g. item/1023) the hard-coded h3 was the only
          // heading under the h1, outlining the page h1 → h3. Every block hard-codes
          // its own level, so a stack permutation can always skip one; this is the
          // level that is right in every permutation the sites actually ship.
          // The visual weight is set by .resources-linked__heading, not by the tag. ?>
    <div class="resources-linked__header">
        <h2 class="resources-linked__heading"><?php echo $this->translate('Linked resources'); ?></h2>
    </div>
    <?php echo $subjectValues; ?>
</div>
<?php endif; ?>
